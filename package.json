{
  "name": "maintenanceos-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "form-stub": "node scripts/form-stub-server.mjs",
    "onboarding-scan": "node --experimental-strip-types packages/onboarding-ingest/src/server.ts",
    "calendar-adapters": "node --experimental-strip-types packages/calendar-adapters/src/server.ts",
    "sandbox-test-call": "node --experimental-strip-types packages/sandbox-test-call/src/server.ts",
    "customer-dashboard": "node --experimental-strip-types packages/customer-dashboard/src/server.ts",
    "fonio-local-stack": "bash scripts/fonio-local-stack.sh",
    "fonio-local-smoke": "node scripts/fonio-local-smoke.mjs",
    "test": "node --test scripts/*.test.mjs && node --experimental-strip-types --test packages/onboarding-ingest/src/*.test.ts packages/calendar-adapters/src/*.test.ts packages/sandbox-test-call/src/*.test.ts packages/customer-dashboard/src/*.test.ts src/lib/*.test.ts"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "next": "15.5.25"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "@eslint/eslintrc": "^3"
  }
}
