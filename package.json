{
  "name": "maintenanceos-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/write-release-marker.mjs && next build",
    "start": "npx serve out",
    "lint": "eslint",
    "seo:monitor": "node scripts/seo-live-monitor.mjs",
    "website:monitor": "node scripts/website-health-monitor.mjs",
    "functional:smoke": "node scripts/functional-smoke.mjs",
    "browser:smoke": "node scripts/browser-viewport-smoke.mjs",
    "security:live": "node scripts/live-security-audit.mjs",
    "redteam:staging": "node scripts/staging-red-team.mjs",
    "conversion:acceptance": "node scripts/conversion-acceptance.mjs",
    "uptime:check": "node scripts/website-health-monitor.mjs",
    "deployment:verify": "node scripts/deployment-verifier.mjs",
    "performance:budget": "node scripts/performance-budget.mjs",
    "accessibility:check": "node --test scripts/site-accessibility.test.mjs scripts/create-a11y.test.mjs",
    "form-stub": "node scripts/form-stub-server.mjs",
    "onboarding-scan": "node --use-system-ca --experimental-strip-types packages/onboarding-ingest/src/server.ts",
    "calendar-adapters": "node --experimental-strip-types packages/calendar-adapters/src/server.ts",
    "sandbox-test-call": "node --experimental-strip-types packages/sandbox-test-call/src/server.ts",
    "conversation-benchmark": "node --experimental-strip-types packages/sandbox-test-call/src/conversation-benchmark.ts",
    "customer-dashboard": "node --experimental-strip-types packages/customer-dashboard/src/server.ts",
    "fonio-local-stack": "bash scripts/fonio-local-stack.sh",
    "fonio-local-smoke": "node scripts/fonio-local-smoke.mjs",
    "product-tour": "node scripts/product-tour/render.mjs",
    "product-tour:remux": "node scripts/product-tour/render.mjs --remux",
    "test": "node --test scripts/*.test.mjs && node --experimental-strip-types --test packages/onboarding-ingest/src/*.test.ts packages/calendar-adapters/src/*.test.ts packages/sandbox-test-call/src/*.test.ts packages/customer-dashboard/src/*.test.ts packages/provisioning-gateway/src/*.test.ts packages/provisioning-gateway/src/adapters/*.test.ts packages/receptionist-draft/src/*.test.ts src/lib/*.test.ts",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:verify": "node scripts/deployment-verifier.mjs",
    "rollback:plan": "node scripts/rollback-plan.mjs",
    "manager:monitor": "node scripts/website-manager-loop.mjs monitor",
    "manager:preflight": "node scripts/website-manager-loop.mjs preflight",
    "manager:verify": "node scripts/website-manager-loop.mjs verify",
    "manager:record": "node scripts/website-manager-loop.mjs record",
    "provisioning-gateway": "node --experimental-strip-types packages/provisioning-gateway/src/server.ts",
    "browser:cross": "node scripts/browser-cross-engine-smoke.mjs",
    "browser:install": "playwright install firefox webkit"
  },
  "dependencies": {
    "next": "16.3.8",
    "parse5": "7.3.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "playwright": "1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module"
}
