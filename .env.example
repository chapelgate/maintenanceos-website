DATABASE_URL=sqlite:///maintenanceos_v1.db
DATABASE_DEPLOYMENT_MODE=local
DATABASE_TLS_REQUIRED=false
POSTGRES_PASSWORD=

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_REALTIME_VOICE=alloy

APP_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
INTERNAL_API_TOKEN=
INTERNAL_API_CLIENT_ID=
PUBLIC_BASE_URL=https://YOUR-PUBLIC-DOMAIN.example

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TEST_NUMBER_CONFIRMED=false
TWILIO_HUMAN_TRANSFER_NUMBER=
VERIFY_TWILIO_SIGNATURES=false
ENABLE_PUBLIC_PROVIDER_INGRESS=false
CONTRACTOR_LINK_TTL_SECONDS=86400
ENABLE_CONTRACTOR_PORTAL=false

EMAIL_MODE=mock
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

ENABLE_REALTIME_VOICE=false
VOICE_TENANT_MODE=isolated_test
VOICE_TEST_CLIENT_ID=
VOICE_TRANSCRIPT_GRACE_SECONDS=1.0
VOICE_TRANSCRIPTION_TIMEOUT_SECONDS=5.0
ENABLE_LIVE_EMAIL=false
ENABLE_LIVE_MESSAGING=false
ALLOW_REMOTE_AI_SIDE_EFFECT_ENABLE=false

# Safe operational telemetry and local defence-in-depth limits.
# A distributed edge must independently enforce limits before public ingress.
ENABLE_STRUCTURED_LOGGING=true
PUBLIC_HTTP_RATE_LIMIT_PER_MINUTE=120
PUBLIC_WS_RATE_LIMIT_PER_MINUTE=60

# Pilot authority limits
DEFAULT_AUTO_DISPATCH_LIMIT=0
DEFAULT_QUOTE_APPROVAL_LIMIT=250
DEFAULT_INVOICE_VARIANCE_PERCENT=10

# Optional RSFM cloud control/memory integration. Safe default is disabled.
# Use the dedicated MaintenanceOS app credential issued by the RSFM control plane.
RSFM_INTEGRATION_ENABLED=0
RSFM_CONTROL_PLANE_URL=https://rsfm-control-plane-production.up.railway.app
RSFM_CONTROL_PLANE_TOKEN=
RSFM_TENANT_ID=chapelgate
