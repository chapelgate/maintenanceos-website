# Placeholders only — never commit real secrets.
# DigitalOcean static hosting must keep companion flags OFF / endpoints empty.
# Local e2e (flags ON on loopback only): .env.example.fonio-local and
# docs/FONIO_LOCAL_E2E.md. Do not copy that file into App Platform.
# Staging operator checklist (exact NEXT_PUBLIC_*, rebuild, health order):
# docs/STAGING_COMPANIONS.md
# Readiness / optional enablement: docs/FONIO_WEBSITE_READINESS.md

# Absolute origin of this marketing site (no trailing slash). Used at build time for
# canonical URLs, Open Graph, JSON-LD, sitemap.xml, and robots.txt.
# DigitalOcean staging (current public host):
#   https://seahorse-app-4oasq.ondigitalocean.app
# If unset, src/lib/site-url.ts falls back to that staging origin so static export
# still emits absolute URLs. Set this to the production domain before launch.
NEXT_PUBLIC_SITE_URL=https://seahorse-app-4oasq.ondigitalocean.app
NEXT_PUBLIC_ENVIRONMENT=staging

# Absolute URL of a contract-compliant form endpoint (docs/FORM_ENDPOINT_CONTRACT.md).
# Local stub: http://127.0.0.1:8787/leads  (run `npm run form-stub`)
# Empty, and the retired Railway host, show the mailto fallback and do not
# pretend a submission succeeded. Do not point this at the golden phone line.
# Static export cannot use relative Next.js API routes (e.g. /api/leads).
NEXT_PUBLIC_FORM_ENDPOINT=

# Measurement beacon. Empty disables it (no request, no CORS error).
# Do not fall back to the retired Railway website-events host.
NEXT_PUBLIC_MEASUREMENT_ENDPOINT=

# Copy/CTA gate (pricing tiers, pre-launch banner). Indexing of this honest
# pre-launch site is allowed so AI search engines can cite claims-safe pages.
NEXT_PUBLIC_PUBLIC_LAUNCH=false

# Optional absolute URL of an onboarding scan service (POST { "url": "https://..." }).
# Empty = no crawl is attempted; /create shows an honest queued / early-access
# message and never invents extracted content.
# Static export cannot use relative Next.js API routes (e.g. /api/onboarding/scan).
# Local companion (packages/onboarding-ingest):
#   ONBOARDING_WEB_INGEST=true npm run onboarding-scan
#   NEXT_PUBLIC_ONBOARDING_SCAN_ENDPOINT=http://127.0.0.1:8788/v1/onboarding/scan
# Hosted companion (separate DigitalOcean droplet — not App Platform static,
# not Render, not frozen telephony): docs/ONBOARDING_SCAN_DEPLOY.md
# Staging DigitalOcean env + rebuild + health order: docs/STAGING_COMPANIONS.md
# Readiness / optional enablement: docs/FONIO_WEBSITE_READINESS.md
# Contract: docs/ONBOARDING_SCAN_CONTRACT.md
NEXT_PUBLIC_ONBOARDING_SCAN_ENDPOINT=

# Spoken create-flow preview. Empty uses the browser en-GB voice.
# Do not put a Gemini/Gacrux API key here: the static export would publish it,
# and the golden phone line's credential must not be copied. When a
# website-owned preview URL exists (it holds any provider key server-side),
# set it and rebuild. The voice name defaults to Gacrux.
NEXT_PUBLIC_VOICE_PREVIEW_ENDPOINT=
# NEXT_PUBLIC_VOICE_PREVIEW_VOICE=Gacrux

# Scan companion only (not read by Next). Off by default. Keep host on loopback
# locally. Hosted droplet: ONBOARDING_SCAN_HOST=0.0.0.0 (Docker) or 127.0.0.1
# behind a reverse proxy, and PORT=8788.
# ONBOARDING_WEB_INGEST=false
# Scanner V2 foundation flag. Default OFF. Stage 0/1 only introduces the
# additive corpus/manifest contract; production still uses Scanner V1 until the
# full V2 acceptance gate is passed.
# ONBOARDING_SCANNER_V2=false
# ONBOARDING_SCAN_HOST=127.0.0.1
# ONBOARDING_SCAN_PORT=8788
# ONBOARDING_SCAN_CORS_ORIGIN=http://localhost:3000

# Stub server only (not read by Next). Keep host on loopback.
# FORM_STUB_HOST=127.0.0.1
# FORM_STUB_PORT=8787
# FORM_STUB_CORS_ORIGIN=http://localhost:3000
# FORM_STUB_DATA_FILE=.data/form-stub-leads.jsonl

# Optional calendar adapters (packages/calendar-adapters). Off by default.
# Public flag is inlined at Next build; companion flag is process-only.
#   CALENDAR_ADAPTERS_ENABLED=true CALENDAR_ADAPTER_PROVIDER=mock npm run calendar-adapters
#   NEXT_PUBLIC_CALENDAR_ADAPTERS_ENABLED=true
#   NEXT_PUBLIC_CALENDAR_ENDPOINT=http://127.0.0.1:8789/v1/calendar
# If the public flag is on and the endpoint is empty, /create uses an in-browser mock.
# Hosted companion, only when authorised: separate DigitalOcean process — not
# App Platform static, not Render, not frozen telephony. See docs/SANDBOX_DEPLOY.md.
# Contract: docs/CALENDAR_ADAPTERS_CONTRACT.md
NEXT_PUBLIC_CALENDAR_ADAPTERS_ENABLED=false
NEXT_PUBLIC_CALENDAR_ENDPOINT=

# Companion only (not read by Next). Off by default. Keep host on loopback
# locally. Hosted: CALENDAR_ADAPTERS_HOST=0.0.0.0 and PORT from the platform.
# CALENDAR_ADAPTERS_ENABLED=false
# CALENDAR_ADAPTER_PROVIDER=mock
# CALENDAR_ADAPTERS_HOST=127.0.0.1
# CALENDAR_ADAPTERS_PORT=8789
# CALENDAR_ADAPTERS_CORS_ORIGIN=http://localhost:3000
# Google OAuth scaffold — local/operator only. Never commit real secrets.
# Register redirect URI exactly: http://127.0.0.1:8789/oauth/google/callback
# Then open http://127.0.0.1:8789/oauth/google/start
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# GOOGLE_CALENDAR_CALENDAR_ID=primary
# GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8789/oauth/google/callback
# GOOGLE_CALENDAR_TOKEN_FILE=.data/google-calendar-tokens.json
# Microsoft 365 / Outlook OAuth scaffold — local/operator only. Never commit real secrets.
# Register redirect URI exactly: http://127.0.0.1:8789/oauth/microsoft/callback
# Then open http://127.0.0.1:8789/oauth/microsoft/start
# MICROSOFT_CALENDAR_CLIENT_ID=
# MICROSOFT_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_REFRESH_TOKEN=
# MICROSOFT_CALENDAR_TENANT_ID=common
# MICROSOFT_CALENDAR_REDIRECT_URI=http://127.0.0.1:8789/oauth/microsoft/callback
# MICROSOFT_CALENDAR_TOKEN_FILE=.data/microsoft-calendar-tokens.json

# Optional sandbox test-call (packages/sandbox-test-call). Off by default.
# Public flag is inlined at Next build; companion flag is process-only.
#   SANDBOX_TEST_CALL_ENABLED=true npm run sandbox-test-call
#   NEXT_PUBLIC_SANDBOX_TEST_CALL_ENABLED=true
#   NEXT_PUBLIC_SANDBOX_TEST_CALL_ENDPOINT=http://127.0.0.1:8790/v1/sandbox
# If the public flag is on and the endpoint is empty, /create uses an in-browser
# scripted stub. WebRTC / live media returns not_configured — never a live call.
# Hosted companion, only when authorised: separate DigitalOcean process — not
# App Platform static, not Render, not frozen telephony. See docs/SANDBOX_DEPLOY.md.
# Contract: docs/SANDBOX_TEST_CALL_CONTRACT.md
NEXT_PUBLIC_SANDBOX_TEST_CALL_ENABLED=false
NEXT_PUBLIC_SANDBOX_TEST_CALL_ENDPOINT=

# Companion only (not read by Next). Off by default. Keep host on loopback
# locally. Hosted: SANDBOX_TEST_CALL_HOST=0.0.0.0 and PORT from the platform.
# SANDBOX_TEST_CALL_ENABLED=false
# ONBOARDING_SANDBOX_CALL=false
# SANDBOX_TEST_CALL_HOST=127.0.0.1
# SANDBOX_TEST_CALL_PORT=8790
# SANDBOX_TEST_CALL_CORS_ORIGIN=http://localhost:3000

# Optional customer dashboard (packages/customer-dashboard). Off by default.
# Public flag is inlined at Next build; companion flag is process-only.
#   CUSTOMER_DASHBOARD_ENABLED=true npm run customer-dashboard
#   NEXT_PUBLIC_CUSTOMER_DASHBOARD_ENABLED=true
#   NEXT_PUBLIC_CUSTOMER_DASHBOARD_ENDPOINT=http://127.0.0.1:8791/v1/dashboard
# If the public flag is on and the endpoint is empty, /dashboard uses an
# in-browser SAMPLE / DEMO mock. Empty store: CUSTOMER_DASHBOARD_DEMO_DATA=false
# Hosted companion, only when authorised: separate DigitalOcean process — not
# App Platform static, not Render, not frozen telephony. See docs/DASHBOARD_DEPLOY.md.
# Contract: docs/CUSTOMER_DASHBOARD_CONTRACT.md
# SAMPLE / DEMO labels are required; never present hosted rows as live analytics.
NEXT_PUBLIC_CUSTOMER_DASHBOARD_ENABLED=false
NEXT_PUBLIC_CUSTOMER_DASHBOARD_ENDPOINT=

# Companion only (not read by Next). Off by default. Keep host on loopback
# locally. Hosted: CUSTOMER_DASHBOARD_HOST=0.0.0.0 and PORT from the platform.
# CUSTOMER_DASHBOARD_ENABLED=false
# CUSTOMER_DASHBOARD_DEMO_DATA=true
# CUSTOMER_DASHBOARD_HOST=127.0.0.1
# CUSTOMER_DASHBOARD_PORT=8791
# CUSTOMER_DASHBOARD_CORS_ORIGIN=http://localhost:3000

# Internal-only Agent Factory provisioning gateway. NOT read by Next.js and
# intentionally has no NEXT_PUBLIC_* equivalent. Default OFF. This is a
# server-to-server control plane: browsers/models never receive these credentials.
# PROVISIONING_GATEWAY_ENABLED=false
# PROVISIONING_GATEWAY_HOST=127.0.0.1
# PROVISIONING_GATEWAY_PORT=8792
# PROVISIONING_GATEWAY_STATE_FILE=.data/provisioning-gateway-state.json
# PROVISIONING_GATEWAY_PRINCIPAL_ID=
# PROVISIONING_GATEWAY_KEY_ID=
# PROVISIONING_GATEWAY_HMAC_SECRET=
# PROVISIONING_GATEWAY_TENANT_REFS=
# Step 9 server-only adapter readiness (same provisioning-gateway process).
# No NEXT_PUBLIC_* equivalent. Default provider mutation OFF. The registry
# contains opaque refs/provider metadata and environment-variable NAMES only,
# never credential values.
# ADAPTER_CONNECTOR_REGISTRY_FILE=.data/agent-adapter-connectors.json
# ADAPTER_MUTATIONS_ENABLED=false
