#!/bin/bash
set -euo pipefail

# Ensure we run from repo or task dir properly
TASK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_DIR="$TASK_DIR/repo"
OUT_DIR="$TASK_DIR/out"

# Environment variables
export PORT="${PORT:-3300}"
export MT_HOST="127.0.0.1"
export MT_PORT="$PORT"
export MT_DATA_DIR="$OUT_DIR/data"
export MT_DB_PATH="$MT_DATA_DIR/mt.sqlite"
export MT_MEDIA_DIR="$MT_DATA_DIR/media"
export MT_ADMIN_PASSWORD="dummy-admin-password"

mkdir -p "$MT_DATA_DIR" "$MT_MEDIA_DIR"

cd "$REPO_DIR"

# Ensure venv exists and is activated
if [ ! -d ".venv" ]; then
    python3 -m venv .venv
fi
source .venv/bin/activate

# Install requirements if not already installed
if ! python3 -c "import mt.app" 2>/dev/null; then
    pip install -e ".[app]"
fi

# Create admin if it doesn't exist
python3 -m mt.app.cli create-admin --username admin 2>/dev/null || true

# Run app in foreground
exec python3 -m mt.app
