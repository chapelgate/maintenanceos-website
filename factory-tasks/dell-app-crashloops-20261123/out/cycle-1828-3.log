#!/usr/bin/env bash
# Dell state backup - snapshots critical state to /mnt/d/state-backups/<timestamp>.tar.zst
# with sha256, keeps 14 dailies + 8 weeklies. Hooks into cleanup/retention/disk jobs
# via ExecStartPre wrapper and daily timer.
#
# Critical state sources (filesystem paths only, never secrets):
#   - council verdicts: jobs-work-dell/readiness/council-gates
#   - DONE / MISSION_COMPLETE markers: jobs-work-dell/*/out/MISSION_COMPLETE, out/DONE
#   - status.json / state files: jobs-work-dell/*/status.json, dell-services/state/*
#   - LOOP_STATE: jobs-work-dell/readiness-loop/LOOP_STATE.json
#   - readiness docs: jobs-work-dell/readiness/* (excl. large repos)
#   - dell-services configs: /home/andy/chapelgate/dell-services (excl. secrets/, node_modules, logs)
#   - promises.tsv: dell-services/call-accountability/promises.tsv
#   - user systemd units: /home/andy/.config/systemd/user/*.service, *.timer
#
set -euo pipefail

BACKUP_ROOT="/mnt/d/state-backups"
LOG_DIR="/mnt/d/logs/central/backups"
LOG_FILE="${LOG_DIR}/backup-$(date -u +%Y-%m-%d).log"
CHECKSUM_DIR="/mnt/d/logs/central/backups/checksums"

mkdir -p "$BACKUP_ROOT" "$LOG_DIR" "$CHECKSUM_DIR"

# Guard: /mnt/d must have at least 30G free
mountpoint -q /mnt/d || { echo "$(date -u +%FT%TZ) | FAIL | dell-state-backup | /mnt/d not mounted, backup skipped" >> "$LOG_FILE"; exit 1; }
FREE_G=$(df -BG --output=avail /mnt/d | tail -1 | tr -dc 0-9)
if [ "$FREE_G" -lt 30 ]; then
  echo "$(date -u +%FT%TZ) | FAIL | dell-state-backup | /mnt/d only ${FREE_G}G free (<30G), skipped" >> "$LOG_FILE"
  exit 1
fi

exec 9>/tmp/dell-state-backup.lock; flock -n 9 || { echo "another backup running, skip" >> "$LOG_FILE"; exit 0; }

TS=$(date -u +%Y%m%d-%H%M%S)
BASE="dell-state-${TS}"
OUT="${BACKUP_ROOT}/${BASE}.tar.zst"
CHECKSUM="${CHECKSUM_DIR}/${BASE}.tar.zst.sha256"

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

echo "$(date -u +%FT%TZ) | INFO | dell-state-backup | starting backup ${BASE}" >> "$LOG_FILE"

LISTFILE="${TMPDIR}/include.list"
: > "$LISTFILE"

# council verdicts
[ -d /home/andy/chapelgate/jobs-work-dell/readiness/council-gates ] && find /home/andy/chapelgate/jobs-work-dell/readiness/council-gates -type f 2>/dev/null >> "$LISTFILE" || true

# LOOP_STATE
[ -f /home/andy/chapelgate/jobs-work-dell/readiness-loop/LOOP_STATE.json ] && echo "/home/andy/chapelgate/jobs-work-dell/readiness-loop/LOOP_STATE.json" >> "$LISTFILE" || true

# promises.tsv
[ -f /home/andy/chapelgate/dell-services/call-accountability/promises.tsv ] && echo "/home/andy/chapelgate/dell-services/call-accountability/promises.tsv" >> "$LISTFILE" || true

# dell-services state dir (small files)
[ -d /home/andy/chapelgate/dell-services/state ] && find /home/andy/chapelgate/dell-services/state -type f 2>/dev/null >> "$LISTFILE" || true

# user systemd units
find /home/andy/.config/systemd/user -maxdepth 1 \( -name '*.service' -o -name '*.timer' \) -type f 2>/dev/null >> "$LISTFILE" || true

# DONE / MISSION_COMPLETE markers and status.json across jobs-work-dell (shallow)
find /home/andy/chapelgate/jobs-work-dell -maxdepth 4 \( -name "MISSION_COMPLETE" -o -name "DONE" -o -name "status.json" -o -name "LOOP_STATE*" \) -type f 2>/dev/null >> "$LISTFILE" || true

# readiness docs (top-level md/txt only, exclude large subtrees)
find /home/andy/chapelgate/jobs-work-dell/readiness -maxdepth 2 -type f \( -name '*.md' -o -name '*.txt' -o -name '*.tsv' \) 2>/dev/null >> "$LISTFILE" || true

# dell-services configs (top-level scripts/conf only, no secrets/logs/data/node_modules/repos)
find /home/andy/chapelgate/dell-services -maxdepth 2 -type f \( -name '*.sh' -o -name '*.py' -o -name '*.conf' -o -name '*.json' -o -name '*.tsv' -o -name '*.md' \) ! -path '*/secrets/*' ! -path '*/logs/*' ! -path '*/data/*' ! -path '*/node_modules/*' ! -path '*/.git/*' 2>/dev/null >> "$LISTFILE" || true

# Redacted opencode config (no secrets)
OPENCODE_CFG="/home/andy/.config/opencode/opencode.json"
if [ -f "$OPENCODE_CFG" ]; then
  sed -E 's/("api[_-]?key"|"token"|"secret"|"password"|"jwt")\s*:\s*"[^"]*"/\1: "**REDACTED**"/gi' "$OPENCODE_CFG" > "$TMPDIR/opencode.json"
  echo "$TMPDIR/opencode.json" >> "$LISTFILE"
fi

# Sort and dedupe
sort -u "$LISTFILE" -o "$LISTFILE"

ENTRY_COUNT=$(wc -l < "$LISTFILE")
echo "$(date -u +%FT%TZ) | INFO | dell-state-backup | ${ENTRY_COUNT} files to archive" >> "$LOG_FILE"

if [ "$ENTRY_COUNT" -eq 0 ]; then
  echo "$(date -u +%FT%TZ) | FAIL | dell-state-backup | no files to back up" >> "$LOG_FILE"
  exit 1
fi

# Atomic write: build to temp then move
TMP_OUT="${TMPDIR}/${BASE}.tar.zst.part"

tar -cf - -T "$LISTFILE" 2>/dev/null | zstd -q -T4 -10 -o "$TMP_OUT"

if [ ! -s "$TMP_OUT" ]; then
  echo "$(date -u +%FT%TZ) | FAIL | dell-state-backup | empty archive produced" >> "$LOG_FILE"
  exit 1
fi

# Verify before atomic replace
zstd -tq "$TMP_OUT" || { echo "$(date -u +%FT%TZ) | FAIL | dell-state-backup | zstd verify failed" >> "$LOG_FILE"; exit 1; }

mv -f "$TMP_OUT" "$OUT"

sha256sum "$OUT" | awk '{print $1"  "$2}' > "$CHECKSUM"

SIZE=$(du -h "$OUT" | cut -f1)
ENTRIES=$(zstd -dc "$OUT" | tar -tf - | wc -l)
echo "$(date -u +%FT%TZ) | OK | dell-state-backup | ${BASE} ${SIZE} ${ENTRIES} entries sha256=$(awk '{print $1}' "$CHECKSUM")" >> "$LOG_FILE"

# Retention: keep 14 dailies + 8 weeklies
WEEKLY_DIR="${BACKUP_ROOT}/weeklies"
mkdir -p "$WEEKLY_DIR"

find "$BACKUP_ROOT" -maxdepth 1 -name 'dell-state-*.tar.zst' -type f -mtime +14 -delete 2>/dev/null || true
find "$BACKUP_ROOT" -maxdepth 1 -name 'dell-state-*.tar.zst.sha256' -type f -mtime +14 -delete 2>/dev/null || true

# Promote Sunday backups to weeklies (keep 8)
if [ "$(date -u +%w)" = "0" ] && [ -f "$OUT" ]; then
  cp -f "$OUT" "$WEEKLY_DIR/${BASE}.tar.zst"
  cp -f "$CHECKSUM" "$WEEKLY_DIR/${BASE}.tar.zst.sha256"
fi
ls -1t "$WEEKLY_DIR"/dell-state-*.tar.zst 2>/dev/null | tail -n +9 | while read -r w; do rm -f "$w" "${w%.tar.zst}.sha256"; done

echo "$(date -u +%FT%TZ) | OK | dell-state-backup | retention applied" >> "$LOG_FILE"
