#!/usr/bin/env bash
# Dell disk clean-up: regenerable stuff only.
set -u
LOG="/home/andy/chapelgate/dell-watch/out/disk-cleanup-$(date -u +%Y%m%d-%H%M%S).log"
DRY="${DRY:-1}"

say(){ echo "$@" | tee -a "$LOG"; }

say "=== Disk clean-up $(date '+%F %H %Z') (dry-run=$DRY) ==="
df -h /home | tail -1 | tee -a "$LOG"

# 1. npm cache
if [ -d ~/.npm/_cacache ]; then
  say "npm cache: $(du -sh ~/.npm/_cacache 2>/dev/null | cut -f1)"
  [ "$DRY" = "0" ] && npm cache clean --force 2>/dev/null
fi
# 2. pnpm cache
if [ -d ~/.local/share/pnpm/store ]; then
  say "pnpm store: $(du -sh ~/.local/share/pnpm/store 2>/dev/null | cut -f1)"
  [ "$DRY" = "0" ] && pnpm store prune 2>/dev/null
fi
# 3. pip cache
if [ -d ~/.cache/pip ]; then
  say "pip cache: $(du -sh ~/.cache/pip 2>/dev/null | cut -f1)"
  [ "$DRY" = "0" ] && pip cache purge 2>/dev/null
fi
# 4. cargo cache
if [ -d ~/.cargo ]; then
  say "cargo: $(du -sh ~/.cargo 2>/dev/null | cut -f1)"
fi
# 5. docker build cache
say "docker build cache:"
[ "$DRY" = "0" ] && docker builder prune -f --filter until=168h 2>/dev/null || true
# 6. old factory-runs worktrees older than 7 days
FR=~/chapelgate/factory-runs
if [ -d "$FR" ]; then
  say "factory-runs worktrees >7d:"
  find "$FR" -maxdepth 1 -type d -mtime +7 -print 2>/dev/null | tee -a "$LOG"
  [ "$DRY" = "0" ] && find "$FR" -maxdepth 1 -type d -mtime +7 -exec rm -rf {} + 2>/dev/null
fi
# 7. task out/ cycle logs older than 30 days compressed rather than deleted
say "task out/ cycle logs >30d (compress):"
find ~/chapelgate/factory-tasks ~/chapelgate/jobs-work-dell/tasks -maxdepth 3 -name 'cycle-*.log' -mtime +30 -print 2>/dev/null | tee -a "$LOG"
[ "$DRY" = "0" ] && find ~/chapelgate/factory-tasks ~/chapelgate/jobs-work-dell/tasks -maxdepth 3 -name 'cycle-*.log' -mtime +30 ! -name '*.gz' -exec gzip {} + 2>/dev/null

echo "=== done ===" | tee -a "$LOG"
