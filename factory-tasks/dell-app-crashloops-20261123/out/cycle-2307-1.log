#!/usr/bin/env bash
# Business Evidence Wallet on the Dell: local embedded PostgreSQL (127.0.0.1:55432) + vite dev on 127.0.0.1:8080.
# Mirrors repo startup.sh, but foreground + loopback only. Auth secret is generated locally by pg-local.mjs; never printed.
set -euo pipefail
export EW_PG_RUN=/tmp/bew-pg-run  # repo default socket path is over the 107-char unix socket limit on the Dell
cd "/home/andy/chapelgate/jobs-work-dell/tasks/dell-fix-failing-builds-20261111/dell-fix-business-evidence-wallet/repo"
node scripts/pg-local.mjs start
export DATABASE_URL="$(node scripts/pg-local.mjs url)"
export BETTER_AUTH_SECRET="$(node scripts/pg-local.mjs auth-secret)"
unset BEW_GATEWAY_HTTP_ENABLED || true
node scripts/migrate.mjs
exec node scripts/with-app-env.mjs ./node_modules/.bin/vite dev --host 127.0.0.1 --port 8080 --strictPort
