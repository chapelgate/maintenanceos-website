#!/usr/bin/env node
/**
 * Local **real PostgreSQL 18** cluster for this workspace.
 *
 * Not PGLite. Not a mock. Not Neon. Binaries are the zonkyio/embedded-postgres
 * PostgreSQL 18.4 linux-x64 build (`postgres`, `initdb`, `pg_ctl`).
 *
 * The sandbox is already in a user namespace and `setuid` to a normal user
 * fails with EINVAL. Official PostgreSQL refuses to run as root, so the
 * postmaster is started with:
 *
 *   unshare --user --map-user=<ewpg> --map-group=<ewpg> -- pg_ctl ...
 *
 * Data lives on disk under `data/postgres` (gitignored). The cluster is
 * daemonized by pg_ctl and survives the Node helper exiting.
 *
 * The database password is generated once and stored at `data/pg-password`
 * (gitignored, mode 0600). It is not hard-coded. Restart reuses the file.
 *
 * Commands: start | stop | status | url | auth-secret | wait | reset
 * Environment (no .env file): EW_PG_DATA, EW_PG_PORT, EW_PG_RUN, EW_PG_LOG,
 * EW_PG_DATABASE, EW_PG_USER, EW_PG_PASSWORD.
 */
import { execFileSync, spawnSync } from "node:child_process";
import { randomBytes } from "node:crypto";
import {
  chmodSync,
  copyFileSync,
  cpSync,
  existsSync,
  lstatSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  realpathSync,
  renameSync,
  rmSync,
  statSync,
  symlinkSync,
  writeFileSync,
} from "node:fs";
import { createConnection } from "node:net";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import pg from "pg";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const nativeRoot = join(root, "node_modules/@embedded-postgres/linux-x64/native");
const binDir = join(nativeRoot, "bin");
const libDir = join(nativeRoot, "lib");
const shareDir = join(nativeRoot, "share");
const INITDB = join(binDir, "initdb");
const PG_CTL = join(binDir, "pg_ctl");
const POSTGRES = join(binDir, "postgres");

const DEFAULT_PORT = 55432;
const DEFAULT_USER = "ew";
const DEFAULT_DB = "evidence_wallet";

function defaultPasswordFile(dataDir) {
  return join(dirname(dataDir), "pg-password");
}

function persistPassword(file, password) {
  mkdirSync(dirname(file), { recursive: true });
  writeFileSync(file, `${password}\n`, { encoding: "utf8", mode: 0o600 });
  try {
    chmodSync(file, 0o600);
  } catch {
    // best-effort on filesystems that ignore mode
  }
}

export function loadLocalPassword(passwordFile, envPassword) {
  const fromEnv = typeof envPassword === "string" ? envPassword.trim() : "";
  if (existsSync(passwordFile)) {
    const existing = readFileSync(passwordFile, "utf8").trim();
    if (existing) return existing;
  }
  if (fromEnv) {
    persistPassword(passwordFile, fromEnv);
    return fromEnv;
  }
  const generated = randomBytes(24).toString("base64url");
  persistPassword(passwordFile, generated);
  return generated;
}

export function clusterConfig(overrides = {}) {
  const port = Number(overrides.port ?? process.env.EW_PG_PORT ?? DEFAULT_PORT);
  const dataDir = overrides.dataDir ?? process.env.EW_PG_DATA ?? join(root, "data/postgres");
  const passwordFile =
    overrides.passwordFile ?? process.env.EW_PG_PASSWORD_FILE ?? defaultPasswordFile(dataDir);
  const dbPassword =
    overrides.dbPassword ?? loadLocalPassword(passwordFile, process.env.EW_PG_PASSWORD);
  return {
    dataDir,
    runDir: overrides.runDir ?? process.env.EW_PG_RUN ?? join(root, "data/postgres-run"),
    logFile: overrides.logFile ?? process.env.EW_PG_LOG ?? join(root, "data/postgres.log"),
    port: Number.isInteger(port) && port > 0 ? port : DEFAULT_PORT,
