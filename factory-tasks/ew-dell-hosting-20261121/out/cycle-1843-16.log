#!/bin/sh
set -eu
# Repo root (this file). Sandbox path is /workspace/startup.sh; a clone can live anywhere.
cd "$(dirname "$0")"
node scripts/preview.mjs stop || true
node scripts/pg-local.mjs start
DATABASE_URL="$(node scripts/pg-local.mjs url)"
BETTER_AUTH_SECRET="$(node scripts/pg-local.mjs auth-secret)"
export DATABASE_URL BETTER_AUTH_SECRET
# Fail-closed: Gateway HTTP is OFF unless explicitly armed for certification.
# Do not default to 1 — production/staging must opt in with BEW_GATEWAY_HTTP_ENABLED=1.
# Example cert: BEW_GATEWAY_HTTP_ENABLED=1 sh /workspace/startup.sh
if [ "${BEW_GATEWAY_HTTP_ENABLED:-}" = "1" ]; then
  export BEW_GATEWAY_HTTP_ENABLED=1
else
  unset BEW_GATEWAY_HTTP_ENABLED || true
fi
node scripts/migrate.mjs

need_start=1
if curl -sf -o /dev/null --max-time 2 http://127.0.0.1:8080/; then
  pids_json="$(node scripts/listen-port.mjs pids 8080 || true)"
  has_pg_url=0
  gateway_ok=1
  want_gateway=0
  if [ "${BEW_GATEWAY_HTTP_ENABLED:-}" = "1" ]; then
    want_gateway=1
  fi
  for pid in $(node -e "const j=JSON.parse(process.argv[1]||'{\"pids\":[]}'); console.log((j.pids||[]).join(' '))" "$pids_json"); do
    if [ -r "/proc/$pid/environ" ]; then
      if tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -q '^DATABASE_URL=postgres://'; then
        has_pg_url=1
      fi
    fi
    if [ "$want_gateway" = "1" ]; then
      if [ -r "/proc/$pid/environ" ] && tr '\0' '\n' < "/proc/$pid/environ" | grep -q '^BEW_GATEWAY_HTTP_ENABLED=1'; then
        :
      else
        gateway_ok=0
      fi
    fi
  done
  if [ "$has_pg_url" = "1" ] && [ "$gateway_ok" = "1" ]; then
    need_start=0
  else
    node scripts/listen-port.mjs kill 8080 || true
    sleep 1
  fi
fi
if [ "$need_start" = "1" ]; then
  npm run dev >>/tmp/app-startup.log 2>&1 &
fi
node scripts/control-mcp.mjs start >/tmp/control-mcp-startup.log 2>&1 || true
