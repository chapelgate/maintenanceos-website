-const BEARER_KEY = "grok-auth.bearer-token";
-
-/** The stored preview bearer token, or null. */
+// The embedded preview iframe has partitioned cookies, so after a popup sign-in
+// we attach the session's bearer token to every Better Auth request (and to
+// server functions, via `@/lib/auth/middleware`).
+//
+// SECURITY (Three-Question Release Gate, 19 Nov 2026): the token is held ONLY in
+// this module's memory. It is never written to sessionStorage, localStorage,
+// indexedDB or a readable cookie, so it does not survive a reload and cannot be
+// lifted from browser storage. A reload in the preview simply needs a new
+// sign-in. Deployed (cookie auth, httpOnly) never sets a token at all.
+// Guarded by scripts/no-token-in-browser-storage.test.mjs.
+let inMemoryBearerToken: string | null = null;
+
+/** The preview bearer token held in memory, or null. */
 export function getBearerToken(): string | null {
   if (typeof window === "undefined") return null;
-  try {
-    return window.sessionStorage.getItem(BEARER_KEY);
-  } catch {
-    return null;
-  }
+  return inMemoryBearerToken;
 }
 
 function setBearerToken(token: string | null): void {
   if (typeof window === "undefined") return;
-  try {
-    if (token) window.sessionStorage.setItem(BEARER_KEY, token);
-    else window.sessionStorage.removeItem(BEARER_KEY);
-  } catch {
-    /* storage unavailable — ignore */
-  }
+  inMemoryBearerToken = token || null;
 }
 
