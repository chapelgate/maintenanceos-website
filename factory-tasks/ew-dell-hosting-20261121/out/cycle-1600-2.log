diff --git a/scripts/no-token-in-browser-storage.test.mjs b/scripts/no-token-in-browser-storage.test.mjs
new file mode 100644
index 00000000..e80ab0f2
--- /dev/null
+++ b/scripts/no-token-in-browser-storage.test.mjs
@@ -0,0 +1,42 @@
+// Three-Question Release Gate guard (CYBER-SECURITY-OWNER, 19 Nov 2026):
+// fails if any auth token / bearer / session secret is written to browser storage again.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync, readdirSync, statSync } from "node:fs";
+import { join } from "node:path";
+
+const ROOT = new URL("..", import.meta.url).pathname;
+const SKIP = new Set(["node_modules", "dist", ".output", "build", ".git", "tests"]);
+
+function sourceFiles(dir) {
+  const out = [];
+  for (const name of readdirSync(dir)) {
+    if (SKIP.has(name)) continue;
+    const p = join(dir, name);
+    if (statSync(p).isDirectory()) out.push(...sourceFiles(p));
+    else if (/\.(ts|tsx|js|jsx|mjs)$/.test(name) && !/\.test\./.test(name)) out.push(p);
+  }
+  return out;
+}
+
+const STORAGE_WRITE = /(sessionStorage|localStorage)\s*\.\s*setItem\s*\(([^)]*)\)|(sessionStorage|localStorage)\s*\[[^\]]*\]\s*=|indexedDB\s*\.\s*open\s*\(|document\s*\.\s*cookie\s*=/g;
+const SENSITIVE = /token|bearer|jwt|session|auth|secret|password|api[_-]?key/i;
+
+test("no auth token or session secret is written to browser storage in src/", () => {
+  const offenders = [];
+  for (const file of sourceFiles(join(ROOT, "src"))) {
+    const text = readFileSync(file, "utf8");
+    for (const m of text.matchAll(STORAGE_WRITE)) {
+      const line = text.slice(0, m.index).split("\n").length;
+      const ctx = text.split("\n").slice(Math.max(0, line - 3), line + 1).join("\n");
+      if (SENSITIVE.test(m[0]) || SENSITIVE.test(ctx)) offenders.push(`${file}:${line}: ${m[0]}`);
+    }
+  }
+  assert.deepEqual(offenders, [], "token/session data must stay in memory or an httpOnly cookie");
+});
+
+test("the preview bearer token is held in memory, not sessionStorage", () => {
+  const client = readFileSync(join(ROOT, "src/lib/auth/client.ts"), "utf8");
+  assert.doesNotMatch(client, /(sessionStorage|localStorage)\s*\./);
+  assert.match(client, /let inMemoryBearerToken/);
+});
\ No newline at end of file
