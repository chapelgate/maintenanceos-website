    import { createFileRoute, Link } from "@tanstack/react-router";
    import { getQuestionnaireFn } from "@/server/fns";
    
    export const Route = createFileRoute("/app/$orgId/questionnaires/$qid")({ component: QDetail });
    
    function QDetail() {
      const { orgId, qid } = Route.useParams();
      const q = useQuery({
        queryKey: ["qn", orgId, qid],
        queryFn: () => getQuestionnaireFn({ data: { orgId, questionnaireId: qid } }),
      });
      if (q.isPending) return <p role="status" aria-busy="true" className="text-muted">Loading questionnaire…</p>;
      if (q.error) return <p role="alert" className="text-red-ink">{q.error.message}</p>;
      if (!q.data) return <p role="alert" className="text-red-ink">Questionnaire not found.</p>;
      return (
        <div className="space-y-4">
          <Link to="/app/$orgId/questionnaires" params={{ orgId }} className="text-sm text-muted underline">
