async function verify(page, packUrl, originalSha) {
  await page.goto(`${base}/login`, { waitUntil: "networkidle", timeout: 30_000 });
  await page.getByLabel("Email").fill(email);
  await page.getByLabel("Password").fill(password);
  await page.getByRole("button", { name: "Sign in with email" }).click();
  await page.waitForURL(/\/app/, { timeout: 20_000 });
  await page.getByRole("link", { name: new RegExp(orgName.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")) }).click();
  await page.waitForURL(/\/app\/org_/);

  await page.locator("aside").getByRole("link", { name: "Facts", exact: true }).click();
  await page.getByText(/10,?000,?000/).first().waitFor({ timeout: 20_000 });

  await page.goto(packUrl, { waitUntil: "networkidle", timeout: 30_000 });
  await page.locator("ol > li").nth(6).waitFor({ timeout: 20_000 });
  await page.getByText("Public Liability").waitFor({ timeout: 15_000 });
  const cards = await page.locator("ol > li").allTextContents();
  const pl = cards.find((t) => t.toLowerCase().includes("public liability"));
  assert.ok(pl && pl.includes("GREEN"), `PL must remain GREEN after restart: ${pl}`);
  assert.match(pl, /approved/i, `PL wording approval must survive restart: ${pl}`);

  await page.locator("aside").getByRole("link", { name: "Exports", exact: true }).click();
  await page.waitForURL(/\/exports/);
  await page.getByRole("heading", { name: "Exports" }).waitFor({ timeout: 15_000 });
  const exportText = await page.locator("main, div.space-y-6").last().innerText().catch(() => "");
  const listed = /\.json|verified|PQQ/i.test(exportText);
  await page.screenshot({ path: "/workspace/screenshots/persist-after-restart.png", fullPage: true });
  if (!listed) {
    console.error("exports page text:", exportText.slice(0, 1500));
  }
  assert.equal(listed, true, `exports must list the JSON file after restart: ${exportText.slice(0, 400)}`);

  await page.locator("aside").getByRole("link", { name: "Evidence", exact: true }).click();
  await page.getByRole("link", { name: "PL-certificate-demo.txt" }).click();
  const afterDownload = page.waitForEvent("download", { timeout: 20_000 });
  await page.getByRole("button", { name: "Download original" }).click();
  const file = await afterDownload;
  const path = await file.path();
  const bytes = readFileSync(path);
  assert.equal(sha256(bytes), originalSha, "downloaded bytes after restart must match the original SHA-256");
  assert.match(bytes.toString("utf8"), /Public Liability Insurance Certificate|GBP 10,000,000/);
}

