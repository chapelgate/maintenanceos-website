import { execFileSync, spawnSync } from "node:child_process";
import { randomBytes } from "node:crypto";
import {
  chmodSync,
  copyFileSync,
  cpSync,
  existsSync,
  lstatSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  realpathSync,
  renameSync,
  rmSync,
  statSync,
  symlinkSync,
  writeFileSync,
} from "node:fs";
import { createConnection } from "node:net";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import pg from "pg";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const nativeRoot = join(root, "node_modules/@embedded-postgres/linux-x64/native");
const binDir = join(nativeRoot, "bin");
const libDir = join(nativeRoot, "lib");
const shareDir = join(nativeRoot, "share");
const INITDB = join(binDir, "initdb");
const PG_CTL = join(binDir, "pg_ctl");
const POSTGRES = join(binDir, "postgres");

const DEFAULT_PORT = 55432;
const DEFAULT_USER = "ew";
const DEFAULT_DB = "evidence_wallet";

function defaultPasswordFile(dataDir) {
  return join(dirname(dataDir), "pg-password");
}

function persistPassword(file, password) {
  mkdirSync(dirname(file), { recursive: true });
  writeFileSync(file, `${password}\n`, { encoding: "utf8", mode: 0o600 });
  try {
    chmodSync(file, 0o600);
  } catch {
    // best-effort on filesystems that ignore mode
  }
}

export function loadLocalPassword(passwordFile, envPassword) {
  const fromEnv = typeof envPassword === "string" ? envPassword.trim() : "";
  if (existsSync(passwordFile)) {
    const existing = readFileSync(passwordFile, "utf8").trim();
    if (existing) return existing;
  }
  if (fromEnv) {
    persistPassword(passwordFile, fromEnv);
    return fromEnv;
  }
  const generated = randomBytes(24).toString("base64url");
  persistPassword(passwordFile, generated);
  return generated;
}

export function clusterConfig(overrides = {}) {
  const port = Number(overrides.port ?? process.env.EW_PG_PORT ?? DEFAULT_PORT);
  const dataDir = overrides.dataDir ?? process.env.EW_PG_DATA ?? join(root, "data/postgres");
  const passwordFile =
    overrides.passwordFile ?? process.env.EW_PG_PASSWORD_FILE ?? defaultPasswordFile(dataDir);
  const dbPassword =
    overrides.dbPassword ?? loadLocalPassword(passwordFile, process.env.EW_PG_PASSWORD);
  return {
    dataDir,
    runDir: overrides.runDir ?? process.env.EW_PG_RUN ?? join(root, "data/postgres-run"),
    logFile: overrides.logFile ?? process.env.EW_PG_LOG ?? join(root, "data/postgres.log"),
    port: Number.isInteger(port) && port > 0 ? port : DEFAULT_PORT,
    dbName: overrides.dbName ?? process.env.EW_PG_DATABASE ?? DEFAULT_DB,
    dbUser: overrides.dbUser ?? process.env.EW_PG_USER ?? DEFAULT_USER,
    dbPassword,
    passwordFile,
    osUid: String(overrides.osUid ?? process.env.EW_PG_OS_UID ?? resolveOsUid()),
    osGid: String(overrides.osGid ?? process.env.EW_PG_OS_GID ?? resolveOsGid()),
    authSecretFile: overrides.authSecretFile ?? join(root, "data/auth-secret"),
  };
}

function resolveOsUid() {
  try {
    return execFileSync("id", ["-u", "ewpg"], { encoding: "utf8" }).trim() || "999";
  } catch {
    return "999";
  }
}

function resolveOsGid() {
  try {
    return execFileSync("id", ["-g", "ewpg"], { encoding: "utf8" }).trim() || "999";
  } catch {
    return "999";
  }
}

export function redactSecret(text, secret) {
  if (!secret) return String(text);
  const raw = String(text);
  const encoded = encodeURIComponent(secret);
  return raw.split(secret).join("***").split(encoded).join("***");
}

export function connectionUrl(cfg = clusterConfig()) {
  const user = encodeURIComponent(cfg.dbUser);
  const password = encodeURIComponent(cfg.dbPassword);
  return `postgres://${user}:${password}@127.0.0.1:${cfg.port}/${cfg.dbName}`;
}

export function redactedConnectionUrl(cfg = clusterConfig()) {
  const user = encodeURIComponent(cfg.dbUser);
  return `postgres://${user}:***@127.0.0.1:${cfg.port}/${cfg.dbName}`;
}

export function adminUrl(cfg = clusterConfig()) {
  const user = encodeURIComponent(cfg.dbUser);
  const password = encodeURIComponent(cfg.dbPassword);
  return `postgres://${user}:${password}@127.0.0.1:${cfg.port}/postgres`;
}

export function authSecret(cfg = clusterConfig()) {
  mkdirSync(dirname(cfg.authSecretFile), { recursive: true });
  if (existsSync(cfg.authSecretFile)) {
    const existing = readFileSync(cfg.authSecretFile, "utf8").trim();
    if (existing) return existing;
  }
  const secret = randomBytes(32).toString("hex");
  writeFileSync(cfg.authSecretFile, `${secret}\n`, { encoding: "utf8", mode: 0o600 });
  try {
    chmodSync(cfg.authSecretFile, 0o600);
  } catch {
    // ignore
  }
  return secret;
}

export function appEnv(cfg = clusterConfig()) {
  return {
    DATABASE_URL: connectionUrl(cfg),
    BETTER_AUTH_SECRET: authSecret(cfg),
  };
}

function hydrateSymlinks() {
  const needed = [
    ["libecpg.so.6.18", "libecpg.so"],
    ["libecpg.so.6.18", "libecpg.so.6"],
    ["libecpg_compat.so.3.18", "libecpg_compat.so"],
    ["libecpg_compat.so.3.18", "libecpg_compat.so.3"],
    ["libicudata.so.60.2", "libicudata.so"],
    ["libicudata.so.60.2", "libicudata.so.60"],
    ["libicui18n.so.60.2", "libicui18n.so"],
    ["libicui18n.so.60.2", "libicui18n.so.60"],
    ["libicuuc.so.60.2", "libicuuc.so"],
    ["libicuuc.so.60.2", "libicuuc.so.60"],
    ["libpgtypes.so.3.18", "libpgtypes.so"],
    ["libpgtypes.so.3.18", "libpgtypes.so.3"],
    ["libpq.so.5.18", "libpq.so"],
    ["libpq.so.5.18", "libpq.so.5"],
  ];
  for (const [file, link] of needed) {
    const src = join(libDir, file);
    const dest = join(libDir, link);
    if (!existsSync(src)) continue;
    try {
      if (existsSync(dest) || lstatSync(dest).isSymbolicLink()) continue;
    } catch {
      // dest missing
    }
    try {
      symlinkSync(file, dest);
    } catch {
      // already linked
    }
  }
}

/**
 * Runner homes often keep node_modules mode 0700. unshare --map-user=ewpg
 * then cannot traverse to the embedded Postgres bins. Stage bin+lib into the
 * cluster runDir (repo-local, mode 0755) before dropping privileges. Binaries
 * carry RUNPATH $ORIGIN/../lib, so the staged layout is enough once traversable.
 */
export function stageNativeForUnshare(cfg) {
  const stageRoot = join(cfg.runDir, "native-stage");
  const stageBin = join(stageRoot, "bin");
  const stageLib = join(stageRoot, "lib");
  mkdirSync(cfg.runDir, { recursive: true });
  mkdirSync(stageBin, { recursive: true });
  mkdirSync(stageLib, { recursive: true });
  for (const dir of [cfg.runDir, stageRoot, stageBin, stageLib]) {
    try {
      chmodSync(dir, 0o755);
    } catch {
      // best-effort
    }
  }
  for (const name of ["initdb", "pg_ctl", "postgres"]) {
    const src = join(binDir, name);
    const dest = join(stageBin, name);
    // Skip when already staged. Restaging over a running postgres raises ETXTBSY.
    if (existsSync(dest) && statSync(dest).size === statSync(src).size) {
      continue;
    }
    const tmp = `${dest}.tmp-${process.pid}`;
    copyFileSync(src, tmp);
    try {
      chmodSync(tmp, 0o755);
    } catch {
      // best-effort
    }
    try {
      renameSync(tmp, dest);
    } catch (err) {
      try { rmSync(tmp, { force: true }); } catch { /* ignore */ }
      if (err && (err.code === "ETXTBSY" || err.code === "EBUSY") && existsSync(dest)) {
        continue;
      }
      throw err;
    }
  }
  // Materialise every library as a regular file. Node cpSync preserves
  // symlinks as absolute paths back into mode-0700 runner homes; ewpg cannot
  // follow those after unshare, so RUNPATH $ORIGIN/../lib would still fail.
  const stageShare = join(stageRoot, "share");
  const marker = join(stageRoot, ".staged");
  if (!existsSync(marker)) {
    for (const name of readdirSync(libDir)) {
      const src = join(libDir, name);
      const dest = join(stageLib, name);
      if (statSync(src).isDirectory()) {
        // Extension modules ($libdir/*.so) live under lib/postgresql.
        cpSync(src, dest, { recursive: true, dereference: true });
        continue;
      }
      if (!statSync(src).isFile() && !lstatSync(src).isSymbolicLink()) continue;
      copyFileSync(realpathSync(src), dest);
      try {
        chmodSync(dest, 0o755);
      } catch {
        // best-effort
      }
    }
    // initdb resolves share as $ORIGIN/../share/postgresql (postgres.bki et al).
    cpSync(shareDir, stageShare, { recursive: true, dereference: true });
    try {
      chmodSync(stageShare, 0o755);
    } catch {
      // best-effort
    }
    writeFileSync(marker, "1");
  }
  return { stageBin, stageLib, stageShare };
}

function mapCommandToStage(stageBin, command) {
  const base = command.split("/").pop();
  if (base === "initdb" || base === "pg_ctl" || base === "postgres") {
    return join(stageBin, base);
  }
  return command;
}

function asPgUser(cfg, command, args, { timeout = 60_000 } = {}) {
  const directEnv = {
    ...process.env,
    LD_LIBRARY_PATH: libDir,
    LC_ALL: "C",
    LC_MESSAGES: "C",
  };
  if (typeof process.getuid === "function" && process.getuid() !== 0) {
    return spawnSync(command, args, { encoding: "utf8", timeout, cwd: root, env: directEnv });
  }
  const { stageBin } = stageNativeForUnshare(cfg);
  const stagedCommand = mapCommandToStage(stageBin, command);
  const result = spawnSync(
    "unshare",
    [
      "--user",
      `--map-user=${cfg.osUid}`,
      `--map-group=${cfg.osGid}`,
      "--",
      "env",
      "LC_ALL=C",
      "LC_MESSAGES=C",
      stagedCommand,
      ...args,
    ],
    { encoding: "utf8", timeout, cwd: root },
  );
  return result;
}

function assertBinaries() {
  for (const bin of [INITDB, PG_CTL, POSTGRES]) {
    if (!existsSync(bin)) {
      throw new Error(`PostgreSQL binary missing: ${bin}`);
    }
    try {
      chmodSync(bin, 0o755);
    } catch {
      // already executable or read-only
    }
  }
}

function pgCtlStatus(cfg) {
  const result = asPgUser(cfg, PG_CTL, ["-D", cfg.dataDir, "status"], { timeout: 10_000 });
  return result;
}

export async function isRunning(cfg = clusterConfig()) {
  if (!existsSync(join(cfg.dataDir, "PG_VERSION"))) return false;
  const status = pgCtlStatus(cfg);
  if (status.status === 0) return true;
  return tcpReady(cfg.port, 200);
}

function tcpReady(port, timeoutMs = 400) {
  return new Promise((resolve) => {
    const socket = createConnection({ host: "127.0.0.1", port });
    const done = (ok) => {
      socket.removeAllListeners();
      socket.destroy();
      resolve(ok);
    };
    socket.setTimeout(timeoutMs);
    socket.once("connect", () => done(true));
    socket.once("timeout", () => done(false));
    socket.once("error", () => done(false));
  });
}

async function waitForTcp(port, timeoutMs = 20_000) {
  const start = Date.now();
  while (Date.now() - start < timeoutMs) {
    if (await tcpReady(port, 400)) return true;
    await new Promise((r) => setTimeout(r, 150));
  }
  return false;
}

function initCluster(cfg) {
  mkdirSync(cfg.dataDir, { recursive: true });
  mkdirSync(cfg.runDir, { recursive: true });
  mkdirSync(dirname(cfg.logFile), { recursive: true });
  if (existsSync(join(cfg.dataDir, "PG_VERSION"))) return { initialized: false };
  const pwFile = join(cfg.runDir, "pwfile");
  writeFileSync(pwFile, `${cfg.dbPassword}\n`, { mode: 0o600 });
  const result = asPgUser(
    cfg,
    INITDB,
    [
      `--pgdata=${cfg.dataDir}`,
      "--auth=scram-sha-256",
      `--username=${cfg.dbUser}`,
      `--pwfile=${pwFile}`,
      "--encoding=UTF8",
      "--locale=C",
      "--lc-messages=C",
      "--no-instructions",
    ],
    { timeout: 60_000 },
  );
  try {
    rmSync(pwFile, { force: true });
  } catch {
    // ignore
  }
  if (result.status !== 0) {
    throw new Error(
      redactSecret(
        `initdb failed (exit ${result.status}): ${result.stderr || result.stdout || "no output"}`,
        cfg.dbPassword,
      ),
    );
  }
  return { initialized: true, stdout: result.stdout };
}

function postgresOptions(cfg) {
  return `-p ${cfg.port} -k ${cfg.runDir} -h 127.0.0.1`;
}

/**
 * After a sandbox hibernate the postmaster can be gone while postmaster.pid
 * and the unix socket remain. pg_ctl then refuses to start. Clear only when
 * TCP is down and the recorded PID is not a live process.
 */
export function clearStalePostmasterLock(cfg = clusterConfig()) {
  const pidPath = join(cfg.dataDir, "postmaster.pid");
  if (!existsSync(pidPath)) {
    clearUnixSocket(cfg);
    return { cleared: false, reason: "no-pid-file" };
  }
  let pid = 0;
  try {
    pid = Number(readFileSync(pidPath, "utf8").split(/\r?\n/)[0]?.trim());
  } catch {
    pid = 0;
  }
  if (Number.isInteger(pid) && pid > 0) {
    try {
      process.kill(pid, 0);
      return { cleared: false, reason: "process-alive", pid };
    } catch (err) {
      const code = err && typeof err === "object" && "code" in err ? err.code : "";
      if (code === "EPERM") return { cleared: false, reason: "process-unsignable", pid };
    }
  }
  try {
    rmSync(pidPath, { force: true });
  } catch {
    // ignore
  }
  clearUnixSocket(cfg);
  return { cleared: true, pid: Number.isInteger(pid) && pid > 0 ? pid : null };
}

function clearUnixSocket(cfg) {
  const sock = join(cfg.runDir, `.s.PGSQL.${cfg.port}`);
  for (const path of [sock, `${sock}.lock`]) {
    try {
      rmSync(path, { force: true });
    } catch {
      // ignore
    }
  }
}

function startPostmaster(cfg) {
  mkdirSync(cfg.runDir, { recursive: true });
  mkdirSync(dirname(cfg.logFile), { recursive: true });
  const result = asPgUser(
    cfg,
    PG_CTL,
    ["-D", cfg.dataDir, "-l", cfg.logFile, "-w", "-t", "20", "-o", postgresOptions(cfg), "start"],
    { timeout: 30_000 },
  );
  if (result.status !== 0) {
    let log = "";
    try {
      log = readFileSync(cfg.logFile, "utf8").slice(-2000);
    } catch {
      // ignore
    }
    throw new Error(
      redactSecret(
        `pg_ctl start failed (exit ${result.status}): ${result.stderr || result.stdout || ""}\n${log}`,
        cfg.dbPassword,
      ),
    );
  }
}

export async function stopCluster(cfg = clusterConfig()) {
  if (!existsSync(join(cfg.dataDir, "PG_VERSION"))) {
    return { stopped: false, reason: "no-cluster" };
  }
  const result = asPgUser(cfg, PG_CTL, ["-D", cfg.dataDir, "-m", "fast", "stop"], { timeout: 20_000 });
  const start = Date.now();
  while (Date.now() - start < 10_000) {
    if (!(await tcpReady(cfg.port, 200))) break;
    await new Promise((r) => setTimeout(r, 150));
  }
  return {
    stopped: result.status === 0 || !(await tcpReady(cfg.port, 200)),
    exit: result.status,
    stdout: (result.stdout || "").trim(),
    stderr: redactSecret((result.stderr || "").trim(), cfg.dbPassword),
  };
}

async function ensureDatabase(cfg) {
  const pool = new pg.Pool({
    connectionString: adminUrl(cfg),
    connectionTimeoutMillis: 5_000,
    max: 1,
  });
  try {
    const found = await pool.query("select 1 from pg_database where datname = $1", [cfg.dbName]);
    if (found.rowCount === 0) {
      await pool.query(`CREATE DATABASE ${quoteIdent(cfg.dbName)} OWNER ${quoteIdent(cfg.dbUser)}`);
      return { created: true };
    }
    return { created: false };
  } catch (err) {
    const message = err instanceof Error ? err.message : String(err);
    throw new Error(redactSecret(message, cfg.dbPassword));
  } finally {
    await pool.end().catch(() => undefined);
  }
}

export function quoteIdent(value) {
  return `"${String(value).replaceAll('"', '""')}"`;
}

export async function startCluster(cfg = clusterConfig(), { reset = false } = {}) {
  hydrateSymlinks();
  assertBinaries();
  if (reset) {
    await stopCluster(cfg);
    rmSync(cfg.dataDir, { recursive: true, force: true });
    if (await tcpReady(cfg.port, 300)) {
      throw new Error(
        `PostgreSQL port ${cfg.port} is already in use; isolated reset refuses to attach to a foreign cluster (password mismatch risk)`,
      );
    }
  }
  mkdirSync(dirname(cfg.dataDir), { recursive: true });
  const init = initCluster(cfg);
  let started = false;
  let staleLock = { cleared: false, reason: "tcp-ready" };
  if (!(await tcpReady(cfg.port, 300))) {
    staleLock = clearStalePostmasterLock(cfg);
    startPostmaster(cfg);
    started = true;
  } else if (reset) {
    throw new Error(
      `PostgreSQL port ${cfg.port} became occupied during isolated reset; refusing to attach`,
    );
  }
  const ready = await waitForTcp(cfg.port, 20_000);
  if (!ready) {
    throw new Error(`PostgreSQL did not accept connections on 127.0.0.1:${cfg.port}`);
  }
  const database = await ensureDatabase(cfg);
  return {
    ok: true,
    engine: "postgresql",
    versionFile: existsSync(join(cfg.dataDir, "PG_VERSION"))
      ? readFileSync(join(cfg.dataDir, "PG_VERSION"), "utf8").trim()
      : null,
    port: cfg.port,
    dataDir: cfg.dataDir,
    dbName: cfg.dbName,
    dbUser: cfg.dbUser,
    passwordFile: cfg.passwordFile,
    initialized: init.initialized,
    started,
    staleLock,
    databaseCreated: database.created,
    urlHost: "127.0.0.1",
  };
}

export async function resetCluster(cfg = clusterConfig()) {
  return startCluster(cfg, { reset: true });
}

export async function statusCluster(cfg = clusterConfig()) {
  const running = await isRunning(cfg);
  const pgVersion = existsSync(join(cfg.dataDir, "PG_VERSION"))
    ? readFileSync(join(cfg.dataDir, "PG_VERSION"), "utf8").trim()
    : null;
  let version = null;
  if (running) {
    const pool = new pg.Pool({
      connectionString: adminUrl(cfg),
      connectionTimeoutMillis: 3_000,
      max: 1,
    });
    try {
      const row = await pool.query("select version() as version");
      version = row.rows[0]?.version ?? null;
    } catch (err) {
      version = redactSecret(err instanceof Error ? err.message : String(err), cfg.dbPassword);
    } finally {
      await pool.end().catch(() => undefined);
    }
  }
  return {
    running,
    engine: "postgresql",
    pgVersion,
    version,
    port: cfg.port,
    dataDir: cfg.dataDir,
    dbName: cfg.dbName,
    passwordFile: cfg.passwordFile,
  };
}

export async function waitCluster(cfg = clusterConfig(), timeoutMs = 20_000) {
  const ok = await waitForTcp(cfg.port, timeoutMs);
  if (!ok) throw new Error(`timeout waiting for PostgreSQL on 127.0.0.1:${cfg.port}`);
  return { ok: true, port: cfg.port };
}

function printJson(value) {
  console.log(JSON.stringify(value));
}

async function main() {
  const action = process.argv[2] || "status";
  const cfg = clusterConfig();
  if (action === "start") {
    printJson(await startCluster(cfg));
    return;
  }
  if (action === "stop") {
    printJson(await stopCluster(cfg));
    return;
  }
  if (action === "status") {
    printJson(await statusCluster(cfg));
    return;
  }
  if (action === "url") {
    process.stdout.write(`${connectionUrl(cfg)}\n`);
    return;
  }
  if (action === "auth-secret") {
    process.stdout.write(`${authSecret(cfg)}\n`);
    return;
  }
  if (action === "wait") {
    printJson(await waitCluster(cfg));
    return;
  }
  if (action === "reset") {
    printJson(await resetCluster(cfg));
    return;
  }
  console.error("usage: node scripts/pg-local.mjs start|stop|status|url|auth-secret|wait|reset");
  process.exit(2);
}

const invokedDirectly = process.argv[1]?.endsWith("pg-local.mjs");
if (invokedDirectly) {
  main().catch((err) => {
    const cfg = clusterConfig();
    const message = err instanceof Error ? err.message : String(err);
    console.error("[pg-local]", redactSecret(message, cfg.dbPassword));
    process.exit(1);
  });
}
