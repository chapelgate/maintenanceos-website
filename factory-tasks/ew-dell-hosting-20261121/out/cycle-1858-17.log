#!/usr/bin/env bash
# Suite section generator - runs every 2 minutes
# Writes to /home/andy/chapelgate/dell-watch/out/section-snippet.md
set -u

W=/home/andy/chapelgate/dell-watch
K=/home/andy/chapelgate/dell-services/overnight-keepalive
OUT=$W/out/section-snippet.md
mkdir -p $W/out

ts=$(date '+%F %H:%M:%S %Z')

{
echo "### Generated at $ts"
echo
echo "| Suite | Product | State | Cycle | Updated | Pass | Fail | Total | Age (s) |"
echo "|-------|---------|-------|-------|---------|------|------|-------|---------|"

# Get suite data from jobs.tsv
while IFS=$'\t' read -r u run td cyc model; do
  [[ -z "$u" || "$u" == \#* ]] && continue
  if [[ ! $u =~ ^(h25|rt15|rt15r2|sd|ai-stage[1-5]|phone-stage[1-5]|persona-[0-9]+|rl20|redteam15|redteam15-r2|hard25)- ]]; then
    continue
  fi
  product=${u#*-}
  [[ $td != /* ]] && td=/home/andy/chapelgate/$td
  if [ ! -d "$td" ] || [ ! -f "$td/status.json" ]; then
    echo "| $u | $product | missing task dir | - | - | - | - | - | - |"
    continue
  fi
  state=$(jq -r '.state // ""' "$td/status.json" 2>/dev/null)
  cyc=$(jq -r '.cycle // ""' "$td/status.json" 2>/dev/null)
  updated=$(jq -r '.updated // ""' "$td/status.json" 2>/dev/null)
  if [ -f "$td/out/MISSION_COMPLETE" ]; then mc=$(head -1 "$td/out/MISSION_COMPLETE" | sed 's/^# *//' | cut -c1-40); state="$mc"; fi
  systemctl --user is-active --quiet "$u" && state="RUNNING ($state)"

  # parse pass/fail from out/RESULTS.md
  pass=""; fail=""; total=""
  if [ -f "$td/out/RESULTS.md" ]; then
    pass=$(grep -iE '^\s*(\d+)\s*(PASS|pass)' "$td/out/RESULTS.md" 2>/dev/null | head -1 | grep -oE '[0-9]+' || echo -n "-")
    fail=$(grep -iE '^\s*(\d+)\s*(FAIL|fail)' "$td/out/RESULTS.md" 2>/dev/null | head -1 | grep -oE '[0-9]+' || echo -n "-")
    [ "$pass" != "-" ] && [ "$fail" != "-" ] && total=$((pass+fail)) || total="-"
  else
    pass="-"; fail="-"; total="-"
  fi

  # last output age
  age="-"
  if [ -d "$td/out" ]; then
    newest=$(find "$td/out" -type f ! -path "*/runs/*" -printf '%T@\n' 2>/dev/null | sort -n | tail -1 | cut -d. -f1)
    [ -n "$newest" ] && age=$(( $(date +%s) - newest ))
  fi

  echo "| $u | $product | $state | $cyc | $updated | $pass | $fail | $total | $age |"
done < $K/jobs.tsv

echo
echo "### Hang watchdog (last 5 lines)"
if [ -f /home/andy/chapelgate/dell-services/hang-watchdog/hang-watchdog.log ]; then
  tail -n 5 /home/andy/chapelgate/dell-services/hang-watchdog/hang-watchdog.log | sed 's/^/> /'
else
  echo "> (no hang-watchdog log)"
fi

echo
echo "### Mac lane (last 5 lines)"
if [ -f /home/andy/chapelgate/dell-services/mac-lane/logs/mac-lane.log ]; then
  tail -n 5 /home/andy/chapelgate/dell-services/mac-lane/logs/mac-lane.log | sed 's/^/> /'
else
  echo "> (no mac-lane log)"
fi

echo
echo "### Docker rate limits (last 15 min)"
python3 -c "
import re, sys
logs = __import__('subprocess').run(['docker', 'logs', '--since', '15m', 'omniroute'], capture_output=True, text=True).stdout
c429 = sum(1 for _ in re.finditer(r'\\b429\\b', logs))
c5xx = sum(1 for _ in re.finditer(r'\\b5\\d\\d\\b', logs))
if c429 or c5xx:
    print(f'> 429s: {c429}, 5xxs: {c5xx}')
    from collections import Counter
    for k,v in Counter(m.group(2) for m in re.finditer(r'(?i)(provider|model)\\s*[:=]?\\s*([A-Za-z0-9_-]+).*?(reset|cooldown)', logs)).most_common(8):
        print(f'>   cooling: {k} x{v}')
else:
    print('> No 429/5xx in last 15m')
"

} > "$OUT.tmp"
mv "$OUT.tmp" "$OUT"
