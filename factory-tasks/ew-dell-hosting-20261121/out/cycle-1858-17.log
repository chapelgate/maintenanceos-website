-- Evidence Wallet schema. Idempotent. user_id is TEXT (Better Auth / preview).

create table if not exists organisations (
  id text primary key,
  name text not null,
  created_by text not null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table if not exists memberships (
  id text primary key,
  org_id text not null references organisations(id) on delete cascade,
  user_id text not null,
  role text not null check (role in ('owner','admin','reviewer','contributor','viewer')),
  created_at timestamptz not null default now(),
  unique (org_id, user_id)
);
create index if not exists memberships_user_id_idx on memberships (user_id);
create index if not exists memberships_org_id_idx on memberships (org_id);

create table if not exists invitations (
  id text primary key,
  org_id text not null references organisations(id) on delete cascade,
  email text not null,
  role text not null check (role in ('admin','reviewer','contributor','viewer')),
  invited_by text not null,
  created_at timestamptz not null default now(),
  accepted_at timestamptz,
  unique (org_id, email)
);

create table if not exists documents (
  id text primary key,
  org_id text not null references organisations(id) on delete cascade,
  filename text not null,
  stored_filename text not null,
  mime_type text not null,
  kind text not null check (kind in ('pdf','docx','xlsx','txt')),
  byte_size integer not null,
  sha256 text not null,
  status text not null check (status in ('uploaded','parsing','parsed','failed','archived')),
  parse_error text,
  demonstration boolean not null default false,
  created_by text not null,
  created_at timestamptz not null default now()
);
create index if not exists documents_org_id_idx on documents (org_id);

create table if not exists document_versions (
  id text primary key,
  document_id text not null references documents(id) on delete cascade,
  org_id text not null,
  version_number integer not null,
  content bytea not null,
  extracted_text text,
  created_at timestamptz not null default now(),
  unique (document_id, version_number)
);
create index if not exists document_versions_org_id_idx on document_versions (org_id);

create table if not exists extracted_claims (
  id text primary key,
  org_id text not null,
  document_id text not null references documents(id) on delete cascade,
  document_version_id text not null references document_versions(id) on delete cascade,
  canonical_key text not null,
  category text not null,
  display_value text not null,
  numeric_value double precision,
  currency text,
  unit text,
  effective_date date,
  expiry_date date,
  location text,
  extraction_method text not null,
  ai_confidence real,
  raw_snippet text,
  status text not null check (status in ('candidate','approved','rejected')),
  created_at timestamptz not null default now()
);
create index if not exists extracted_claims_org_id_idx on extracted_claims (org_id);
create index if not exists extracted_claims_status_idx on extracted_claims (org_id, status);

create table if not exists facts (
  id text primary key,
  org_id text not null,
  canonical_key text not null,
  category text not null,
  current_version_id text,
  status text not null check (status in ('active','expired','superseded','archived')),
  created_at timestamptz not null default now()
);
create index if not exists facts_org_key_idx on facts (org_id, canonical_key);

create table if not exists fact_versions (
  id text primary key,
  fact_id text not null references facts(id) on delete cascade,
  org_id text not null,
  claim_id text,
  display_value text not null,
  numeric_value double precision,
  currency text,
  unit text,
  effective_date date,
  expiry_date date,
  review_date date,
  source_document_id text,
  source_version_id text,
  source_location text,
  approved_by text not null,
  approved_at timestamptz not null default now(),
  supersedes_version_id text,
  created_at timestamptz not null default now()
);
create index if not exists fact_versions_org_id_idx on fact_versions (org_id);

create table if not exists questionnaires (
  id text primary key,
  org_id text not null references organisations(id) on delete cascade,
  title text not null,
  filename text,
  document_id text,
  status text not null check (status in ('uploaded','parsed','failed')),
  uncertain_json text,
  created_by text not null,
  created_at timestamptz not null default now()
);
create index if not exists questionnaires_org_id_idx on questionnaires (org_id);

create table if not exists questions (
  id text primary key,
  questionnaire_id text not null references questionnaires(id) on delete cascade,
  org_id text not null,
  section text,
  question_identifier text,
  question_text text not null,
  instruction text,
  response_type text not null,
  required boolean not null default true,
  numeric_requirement_json text,
  evidence_request text,
  source_location text,
  extraction_uncertain boolean not null default false,
  suggested_keys_json text not null default '[]',
  sort_order integer not null
);
create index if not exists questions_org_id_idx on questions (org_id);

create table if not exists response_packs (
  id text primary key,
  org_id text not null references organisations(id) on delete cascade,
  questionnaire_id text not null references questionnaires(id) on delete cascade,
  title text not null,
  status text not null check (status in ('draft','in_review','approved','exported')),
  created_by text not null,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index if not exists response_packs_org_id_idx on response_packs (org_id);

create table if not exists proposed_answers (
  id text primary key,
  pack_id text not null references response_packs(id) on delete cascade,
  question_id text not null references questions(id) on delete cascade,
  org_id text not null,
  evidence_status text not null,
  human_state text not null,
  draft_answer text,
  final_answer text,
  rationale text,
  deterministic_json text,
  model_confidence real,
  reviewed_by text,
  reviewed_at timestamptz,
  stale boolean not null default false,
  unique (pack_id, question_id)
);
create index if not exists proposed_answers_org_id_idx on proposed_answers (org_id);

create table if not exists answer_evidence (
  id text primary key,
  answer_id text not null references proposed_answers(id) on delete cascade,
  org_id text not null,
  fact_id text,
  fact_version_id text,
  document_id text,
  location text,
  role text not null default 'primary'
);
create index if not exists answer_evidence_org_id_idx on answer_evidence (org_id);

create table if not exists conflicts (
  id text primary key,
  org_id text not null,
  canonical_key text not null,
  fact_version_ids_json text not null,
  values_json text not null,
  status text not null check (status in ('open','resolved')),
  resolution text,
  resolved_by text,
  resolved_at timestamptz,
  created_at timestamptz not null default now()
);
create index if not exists conflicts_org_id_idx on conflicts (org_id);

create table if not exists jobs (
  id text primary key,
  org_id text not null,
  type text not null,
  status text not null check (status in ('queued','running','succeeded','failed')),
  payload_json text not null,
  idempotency_key text,
  result_json text,
  error text,
  attempts integer not null default 0,
  created_at timestamptz not null default now(),
  unique (org_id, idempotency_key)
);
create index if not exists jobs_org_id_idx on jobs (org_id);

create table if not exists exports (
  id text primary key,
  org_id text not null,
  pack_id text not null,
  format text not null check (format in ('json','xlsx','docx')),
  filename text not null,
  content bytea not null,
  verification_json text not null,
  created_by text not null,
  created_at timestamptz not null default now()
);
create index if not exists exports_org_id_idx on exports (org_id);

create table if not exists audit_events (
  id text primary key,
  org_id text not null,
  actor_user_id text not null,
  action text not null,
  entity_type text not null,
  entity_id text,
  metadata_json text,
  created_at timestamptz not null default now()
);
create index if not exists audit_events_org_id_idx on audit_events (org_id, created_at desc);
