#!/usr/bin/env bash
# Dell build progress watch (read-only). Every 15 min via cron.
# Lists every running user unit matching dell-*, factory-*, research-*, job-*,
# every task folder with a status.json, and flags FAILING-FAST jobs.
# Includes "Test suites, all 12 products" section regenerated every 2 min
# by the separate suite-timer script (out/section-snippet.md).
set -u

W=~/chapelgate/dell-watch
S=$W/STATUS.md
H=$W/omniroute-health.json
now=$(date +%s)

# Check inotify watch count
INOTIFY_WATCHES=$(cat /proc/sys/fs/inotify/max_user_watches 2>/dev/null || echo "unknown")
INOTIFY_USED=$(journalctl --user --since '-30 min' 2>/dev/null | grep -c 'inotify watch' || echo "0")
if [ "$INOTIFY_WATCHES" != "unknown" ] && [ "$INOTIFY_USED" -gt 50000 ]; then
  echo "WARNING: Inotify watches used ($INOTIFY_USED) approaching limit ($INOTIFY_WATCHES)"
fi

# Collect running units matching prefixes.
units_dell=$(systemctl --user list-units --type=service --all --no-legend --no-pager 2>/dev/null | awk '{print $1}' | grep -E '^dell-' || true)
units_factory=$(systemctl --user list-units --type=service --all --no-legend --no-pager 2>/dev/null | awk '{print $1}' | grep -E '^factory-' || true)
units_research=$(systemctl --user list-units --type=service --all --no-legend --no-pager 2>/dev/null | awk '{print $1}' | grep -E '^research-' || true)
units_job=$(systemctl --user list-units --type=service --all --no-legend --no-pager 2>/dev/null | awk '{print $1}' | grep -E '^job-' || true)

{
echo "# Dell build watch $(date '+%F %H:%M %Z')"
echo

echo "## User units (dell-*, factory-*, research-*, job-*)"
echo
for u in $units_dell $units_factory $units_research $units_job; do
  st=$(systemctl --user show -p ActiveState,SubState,UnitFileState --value "$u" 2>/dev/null | tr '\n' ' ')
  echo "- $st $u"
done

echo
echo "## Stale check (auto, every 15 min)"
echo
cat "$W/out/STALE-CHECK.md" 2>/dev/null | tail -n +3 | head -20
cat /home/andy/chapelgate/dell-watch/REEL-PIPELINE.md 2>/dev/null  # eggbot 19 Nov: reel pipeline + GPU line
tail -3 /home/andy/chapelgate/jobs-work-dell/readiness/chief/FOCUS-DRIFT.md 2>/dev/null | sed "s/^- /- FOCUS /"  # eggbot 21 Nov J0380
echo
python3 "$W/bin/dash_tasks.py" section
echo
echo "## Synthetic fast-fail test folders"
for d in /home/andy/chapelgate/test-fast-fail; do
  [ -d "$d" ] || continue
  name=$(basename "$d")
  failing=""
  if grep -lqiE 'Authentication required|No space left|rate limit|401' "$d"/*.log 2>/dev/null || [ $(find "$d" -maxdepth 1 -name 'cycle-*.log' | wc -l) -ge 3 ]; then
    failing="FAILING-FAST (3+ rapid cycle logs)"
  fi
  echo "- $name | ${failing:-ok}"
done

echo
echo "## Test suites, all 12 products"
echo
# suite section regenerated every 2 min; fall back to empty note if stale
sec=$W/out/section-snippet.md
if [ -f "$sec" ] && [ $((now - $(stat -c %Y "$sec" 2>/dev/null || echo 0))) -le 300 ]; then
  awk '!seen[$0]++ || /^\|/ || /^$/' "$sec"
else
  echo "* suite section: regenerating (2-min timer), see $W/out/section-snippet.md *"
fi

echo
echo "## OmniRoute health"
if [ -f "$H" ]; then
  python3 - "$H" <<'PY'
