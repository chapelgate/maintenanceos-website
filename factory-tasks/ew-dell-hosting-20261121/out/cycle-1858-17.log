#!/usr/bin/env node
/**
 * Live application restart persistence against **real PostgreSQL**.
 *
 * Isolated by default: throwaway cluster + non-8080 app port so the live
 * preview on 8080 is not disrupted. Set EW_HTTP_USE_LIVE=1 to target the
 * preview app and the shared local cluster (legacy / operator use).
 *
 * Sign up → org → demo pack → approve facts → pack → export →
 * stop the app **and** the PostgreSQL postmaster → start both →
 * sign in → assert organisation, facts, pack, export, original document
 * bytes remain. Then stop PostgreSQL while the app stays up and assert
 * fail-closed behaviour, then start PostgreSQL and assert recovery.
 */
import assert from "node:assert/strict";
import { spawn, spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import { openSync, readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { chromium } from "playwright";
import { killListenPort } from "./listen-port.mjs";
import {
  appEnv,
  clusterConfig,
  startCluster,
  statusCluster,
  stopCluster,
} from "./pg-local.mjs";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const isolated = process.env.EW_HTTP_USE_LIVE !== "1";
const httpPort = isolated
  ? Number.parseInt(process.env.EW_HTTP_PORT || "8090", 10) || 8090
  : Number.parseInt(process.env.EW_HTTP_PORT || "8080", 10) || 8080;
const base = process.env.E2E_BASE_URL || `http://127.0.0.1:${httpPort}`;
const email = `persist.${Date.now()}@example.com`;
const password = "CorrectHorseBattery1";
const orgName = `HTTP Persist ${Date.now()}`;
const cfg = isolated
  ? clusterConfig({
      port: Number.parseInt(process.env.EW_PG_PORT || "55433", 10) || 55433,
      dataDir: join(root, "data/postgres-http-persist"),
      runDir: join(root, "data/postgres-http-persist-run"),
      logFile: join(root, "data/postgres-http-persist.log"),
      passwordFile: join(root, "data/pg-password-http-persist"),
      dbName: "evidence_wallet_http",
      authSecretFile: join(root, "data/auth-secret-http-persist"),
    })
  : clusterConfig();

function sha256(bytes) {
  return createHash("sha256").update(bytes).digest("hex");
}

async function waitForHttp(timeoutMs = 90_000) {
  const start = Date.now();
  let last = "not contacted";
  while (Date.now() - start < timeoutMs) {
    try {
      const res = await fetch(base, { redirect: "manual" });
      last = String(res.status);
      if (res.status > 0 && res.status < 500) return;
    } catch (err) {
      last = err instanceof Error ? err.message : String(err);
    }
    await new Promise((r) => setTimeout(r, 400));
  }
  throw new Error(`timeout waiting for ${base} (${last})`);
}

let appProcessGroupPid = null;

function stopApp() {
  if (appProcessGroupPid) {
    try {
      process.kill(-appProcessGroupPid, "SIGTERM");
    } catch {
      // The process group may already be gone; the listener sweep below is authoritative.
    }
  }
  const stopped = killListenPort(httpPort, { waitMs: 12_000 });
  appProcessGroupPid = null;
  if (!stopped.ok) throw new Error(`Failed to stop the app on port ${httpPort}.`);
}

function startApp() {
  const env = {
    ...process.env,
    ...appEnv(cfg),
    EW_HTTP_PORT: String(httpPort),
    BETTER_AUTH_URL: `http://127.0.0.1:${httpPort}`,
  };
  const log = openSync("/tmp/app-startup-http-persist.log", "a");
  const child = spawn("npm", ["run", "dev"], {
    cwd: root,
    detached: true,
    stdio: ["ignore", log, log],
    env,
  });
  appProcessGroupPid = child.pid;
  child.unref();
}

async function startPostgres({ reset = false } = {}) {
  const started = await startCluster(cfg, reset ? { reset: true } : {});
  const migrate = spawnSync(process.execPath, [join(root, "scripts/migrate.mjs")], {
    cwd: root,
    encoding: "utf8",
    timeout: 30_000,
    env: { ...process.env, ...appEnv(cfg) },
  });
  if (migrate.status !== 0) {
    throw new Error(`migrate failed: ${migrate.stdout}\n${migrate.stderr}`);
  }
  return { started, migrateOut: migrate.stdout };
}

async function restartAppOnly() {
  stopApp();
  const start = Date.now();
  while (Date.now() - start < 15_000) {
    try {
      await fetch(base, { redirect: "manual" });
      await new Promise((r) => setTimeout(r, 300));
    } catch {
      break;
    }
  }
  startApp();
  await waitForHttp();
}

async function restartAppAndPostgres() {
  stopApp();
  const stopped = await stopCluster(cfg);
  const started = await startPostgres();
  startApp();
  await waitForHttp();
  return { dbStopped: stopped.stopped, dbStarted: started.started.ok };
}

