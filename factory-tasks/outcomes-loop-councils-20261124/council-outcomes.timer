#!/usr/bin/env python3
"""council-outcomes.timer - hourly timer that appends council outcome records to COUNCIL-OUTCOMES.tsv.

Follows BRIEF.md §2-5 and STEER.md §4: hash chain, anchors, verify-on-read, append-only.
"""
import os, sys, json, subprocess, hashlib, datetime, fcntl

C = '/home/andy/chapelgate'
OUT = os.path.join(C, 'jobs-work-dell', 'readiness')
TSV = os.path.join(OUT, 'COUNCIL-OUTCOMES.tsv')
OUTCOMES_DIR = os.path.join(C, 'factory-tasks', 'outcomes-loop-councils-20261124')
BRIEF = os.path.join(C, 'factory-tasks', 'outcomes-loop-councils-20261124', 'BRIEF.md')
STEER = os.path.join(C, 'factory-tasks', 'outcomes-loop-councils-20261124', 'STEER.md')

GENESIS_HASH = hashlib.sha256("chapelgate-council-outcomes-genesis".encode()).hexdigest()

# Anchor paths
ANCHOR_REPO = os.path.join(C, 'dell-services', 'council-outcomes-anchor')
STATUS_FILE = os.path.join(OUT, 'STATUS.md')

def get_prev_hash():
    """Get the last hash from the TSV file, or genesis if empty/new."""
    if not os.path.exists(TSV):
        return GENESIS_HASH
    with open(TSV, 'r') as f:
        lines = f.readlines()
    if not lines:
        return GENESIS_HASH
    last_line = lines[-1].strip()
    if not last_line:
        return GENESIS_HASH
    # Last column is the hash
    parts = last_line.rsplit('|', 1)
    if len(parts) >= 2:
        return parts[1]
    return GENESIS_HASH

def compute_row_hash(prev_hash, row_text):
    """Compute sha256(prev_hash + row) for the hash chain."""
    return hashlib.sha256((prev_hash + row_text).encode()).hexdigest()

def append_outcome_row(decision, tier, sha, reviewers, families, later_event=None, later_at=None):
    """Append a single outcome row to COUNCIL-OUTCOMES.tsv with hash chain."""
    prev_hash = get_prev_hash()
    
    # Build the row content (without the trailing hash)
    row_content = f"{decision}|{tier}|{sha}|{reviewers}|{families}"
    if later_event:
        row_content += f"|{later_event}"
    if later_at:
        row_content += f"|{later_at}"
    
    # Compute the hash for this row
    row_hash = compute_row_hash(prev_hash, row_content)
    
    # Full row: content + hash
    full_row = f"{row_content}|{row_hash}\n"
    
    # Append atomically with file lock
    with open(TSV, 'a') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.write(full_row)
        fcntl.flock(f, fcntl.LOCK_UN)
    
    # Also append head hash to Mac anchor log if ssh is available
    mac_anchor_path = os.path.expanduser("~/chapelgate-ceo/anchors/council-outcomes-heads.log")
    mac_anchor_dir = os.path.dirname(mac_anchor_path)
    mac_anchor_line = f"{datetime.datetime.now().isoformat()} {row_hash}"
    
    # Try to append via existing ssh path (do not create keys or cron)
    try:
        result = subprocess.run(
            ['ssh', 'mac', f'mkdir -p {mac_anchor_dir} && cat >> {mac_anchor_path}'],
            capture_output=True, text=True, timeout=10
        )
        # If ssh fails (no working path), that's OK - we log it but continue
        if result.returncode != 0:
            # Mac anchor not available via ssh - this is expected in some setups
            pass
    except Exception:
        # No working ssh path - continue without Mac anchor
        pass
    
    # Commit head hash to local git anchor repo
    try:
        os.makedirs(ANCHOR_REPO, exist_ok=True)
        anchor_file = os.path.join(ANCHOR_REPO, 'head-hash.txt')
        with open(anchor_file, 'w') as f:
            f.write(f"{row_hash}\n")
        # Check if git repo exists, init if not
        if not os.path.exists(os.path.join(ANCHOR_REPO, '.git')):
            subprocess.run(['git', 'init'], cwd=ANCHOR_REPO, capture_output=True)
            subprocess.run(['git', 'config', 'user.name', 'council-outcomes-bot'], cwd=ANCHOR_REPO, capture_output=True)
            subprocess.run(['git', 'config', 'user.email', 'bot@chapelgate.local'], cwd=ANCHOR_REPO, capture_output=True)
        subprocess.run(['git', 'add', 'head-hash.txt'], cwd=ANCHOR_REPO, capture_output=True)
        # Check if there are changes to commit
        result = subprocess.run(['git', 'status', '--porcelain'], cwd=ANCHOR_REPO, capture_output=True, text=True)
        if result.stdout.strip():
            commit_msg = f"anchor: council outcomes head {row_hash[:16]}... at {datetime.datetime.now().isoformat()}"
            subprocess.run(['git', 'commit', '-m', commit_msg], cwd=ANCHOR_REPO, capture_output=True)
    except Exception:
        pass
    
    # Append head hash to STATUS.md daily (only once per day)
    try:
        today = datetime.datetime.now().strftime('%Y-%m-%d')
        if os.path.exists(STATUS_FILE):
            with open(STATUS_FILE, 'r') as f:
                lines = f.readlines()
            # Check if today already has an entry
            already_today = any(line.startswith(today) for line in lines)
            if not already_today:
                with open(STATUS_FILE, 'a') as f:
                    f.write(f"{datetime.datetime.now().isoformat()} {row_hash}\n")
        else:
            with open(STATUS_FILE, 'a') as f:
                f.write(f"{datetime.datetime.now().isoformat()} {row_hash}\n")
    except Exception:
        pass
    
    return full_row

def main():
    """Main entry point for the hourly timer."""
    # Parse any command-line args or environment for outcome data
    # Expected format: decision tier sha "reviewers" "families" [later_event later_at]
    args = sys.argv[1:]
    
    if len(args) >= 5:
        decision = args[0]
        tier = args[1]
        sha = args[2]
        reviewers = args[3]
        families = args[4]
        later_event = args[5] if len(args) > 5 else ""
        later_at = args[6] if len(args) > 6 else ""
    else:
        # No args provided - this is a backfill/run without specific outcome
        # Read from existing council outcomes if available
        print("No outcome data provided via CLI. Reading from existing records...")
        if os.path.exists(TSV):
            with open(TSV, 'r') as f:
                lines = f.readlines()
            print(f"Existing COUNCIL-OUTCOMES.tsv has {len(lines)} lines")
            for line in lines[-5:] if len(lines) > 5 else lines:
                print(f"  {line.strip()[:100]}")
        else:
            print("No COUNCIL-OUTCOMES.tsv found yet. Creating with genesis hash.")
            # Initialize with genesis
            with open(TSV, 'w') as f:
                f.write(f"genesis|{GENESIS_HASH}\n")
        return
    
    row = append_outcome_row(decision, tier, sha, reviewers, families, later_event, later_at)
    print(f"Appended outcome row: {row.strip()[:80]}...")

if __name__ == '__main__':
    main()