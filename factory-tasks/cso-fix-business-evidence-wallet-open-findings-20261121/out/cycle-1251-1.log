import assert from "node:assert/strict";
import { describe, it } from "node:test";

const {
  CANONICAL_KEYS,
  NUMERIC_STAT_KEYS,
  categoryForKey,
  relatedExpiryKey,
  isExpiryKey,
  isEmployeeCountQuestion,
  keysForQuestionText,
  otherKey,
} = await import("../src/domain/canonical.ts");

describe("canonical keys lock", () => {
  it("keeps the 26 canonical keys", () => {
    assert.equal(Object.keys(CANONICAL_KEYS).length, 26);
    assert.equal(CANONICAL_KEYS.PL_LIMIT, "insurance.public_liability.limit");
    assert.equal(CANONICAL_KEYS.PL_EXPIRY, "insurance.public_liability.expiry");
    assert.equal(CANONICAL_KEYS.EL_LIMIT, "insurance.employers_liability.limit");
    assert.equal(CANONICAL_KEYS.EL_EXPIRY, "insurance.employers_liability.expiry");
    assert.equal(CANONICAL_KEYS.EMPLOYEES, "company.employee_count");
    assert.equal(CANONICAL_KEYS.TURNOVER, "company.turnover");
    assert.equal(CANONICAL_KEYS.LEGAL_NAME, "company.legal_name");
    assert.equal(CANONICAL_KEYS.ISO9001_STATUS, "certification.iso_9001.status");
    assert.equal(CANONICAL_KEYS.ISO9001_EXPIRY, "certification.iso_9001.expiry");
    assert.equal(CANONICAL_KEYS.LIVING_WAGE, "policy.living_wage");
    assert.equal(CANONICAL_KEYS.CSCS_STATUS, "certification.cscs.status");
    assert.equal(CANONICAL_KEYS.CSCS_EXPIRY, "certification.cscs.expiry");
    assert.equal(CANONICAL_KEYS.CPCS_STATUS, "certification.cpcs.status");
    assert.equal(CANONICAL_KEYS.CPCS_EXPIRY, "certification.cpcs.expiry");
    assert.ok(CANONICAL_KEYS.SMAS_STATUS);
    assert.ok(CANONICAL_KEYS.SMAS_EXPIRY);
    assert.equal(CANONICAL_KEYS.PROFESSIONAL_INDEMNITY_LIMIT, "insurance.professional_indemnity.limit");
    assert.equal(CANONICAL_KEYS.PROFESSIONAL_INDEMNITY_EXPIRY, "insurance.professional_indemnity.expiry");
    assert.equal(CANONICAL_KEYS.MOTOR_INSURANCE_LIMIT, "insurance.motor_insurance.limit");
    assert.equal(CANONICAL_KEYS.MOTOR_INSURANCE_EXPIRY, "insurance.motor_insurance.expiry");
    assert.equal(CANONICAL_KEYS.CYBER_ESSENTIALS_STATUS, "certification.cyber_essentials.status");
    assert.equal(CANONICAL_KEYS.CYBER_ESSENTIALS_EXPIRY, "certification.cyber_essentials.expiry");
    assert.equal(CANONICAL_KEYS.ISO_27001_STATUS, "certification.iso_27001.status");
    assert.equal(CANONICAL_KEYS.ISO_27001_EXPIRY, "certification.iso_27001.expiry");
    assert.equal(CANONICAL_KEYS.COMPANY_NUMBER, "company.number");
    assert.equal(CANONICAL_KEYS.BUSINESS_CONTINUITY_PLAN, "policy.business_continuity_plan");
  });
