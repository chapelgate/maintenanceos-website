#!/usr/bin/env node
/**
 * Test wrapper for rollback-rehearsal.mjs.
 * Runs the rehearsal, requires exit 0, requires the pre-upgrade, upgraded, and
 * restored assertions, rejects output containing database URLs or secrets.
 */
import { test } from "node:test";
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import { createServer } from "node:net";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { findFreePort } from "./rollback-rehearsal.mjs";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const script = join(root, "scripts/rollback-rehearsal.mjs");
const RESERVED_PORTS = new Set([55432, 55434, 8080]);

function listenLoopback(port) {
  const server = createServer();
  return new Promise((resolve, reject) => {
    server.once("error", reject);
    server.listen(port, "127.0.0.1", () => resolve(server));
  });
}

test("free-port chooser returns a different non-reserved port when 127.0.0.1:55435 is occupied", async () => {
  const held = await listenLoopback(55435);
  try {
    const address = held.address();
    assert.equal(address.address, "127.0.0.1");
    assert.equal(address.port, 55435);
    const port = await findFreePort();
    assert.equal(typeof port, "number");
    assert.notEqual(port, 55435);
    assert.equal(RESERVED_PORTS.has(port), false);
  } finally {
    await new Promise((resolve, reject) => {
      held.close((err) => (err ? reject(err) : resolve()));
    });
  }
});

function runRehearsal() {
  const result = spawnSync(process.execPath, [script], {
    cwd: root,
    encoding: "utf8",
    timeout: 300_000,
    maxBuffer: 10 * 1024 * 1024,
  });
  return {
    status: result.status,
    stdout: result.stdout || "",
    stderr: result.stderr || "",
  };
}

test("restores a synthetic pre-0011 backup after applying migrations through 0027", async () => {
  const { status, stdout, stderr } = runRehearsal();

  // Exit code must be 0
  assert.equal(status, 0, `Rehearsal exited with ${status}. stderr: ${stderr.slice(-500)}`);

  // Output must not contain database URLs or secrets
  const combined = `${stdout}\n${stderr}`;
  assert.ok(!/postgres:\/\//i.test(combined), "Output contains postgres:// URL");
  assert.ok(!/postgresql:\/\//i.test(combined), "Output contains postgresql:// URL");
  assert.ok(!/password/i.test(combined), "Output contains 'password'");
  assert.ok(!/secret/i.test(combined), "Output contains 'secret'");
  assert.ok(!/token/i.test(combined), "Output contains 'token'");
  assert.ok(!/cookie/i.test(combined), "Output contains 'cookie'");
  assert.ok(!/credential/i.test(combined), "Output contains 'credential'");

  // Parse JSON output from the last line
  const lines = stdout.trim().split("\n");
  const lastLine = lines[lines.length - 1];
  let parsed;
  try {
    parsed = JSON.parse(lastLine);
  } catch {
    throw new Error(`Last line of stdout is not valid JSON: ${lastLine.slice(-200)}`);
  }

  // Required assertions
  assert.equal(parsed.ok, true, "Rehearsal did not report ok=true");
  assert.ok(typeof parsed.port === "number" && parsed.port > 0, "Missing or invalid port");
  assert.equal(parsed.markerPreUpgrade, true, "Marker did not survive pre-upgrade");
  assert.equal(parsed.markerPostUpgrade, true, "Marker did not survive post-upgrade");
  assert.equal(parsed.markerPostRestore, true, "Marker did not survive restore");
  assert.ok(parsed.preUpgradeMigrations >= 10, `Expected at least 10 pre-upgrade migrations, got ${parsed.preUpgradeMigrations}`);
  assert.ok(parsed.postUpgradeMigrations >= 27, `Expected at least 27 post-upgrade migrations, got ${parsed.postUpgradeMigrations}`);
  assert.equal(parsed.postRestoreMigrations, 10, `Expected exactly 10 migrations after restore, got ${parsed.postRestoreMigrations}`);
});
