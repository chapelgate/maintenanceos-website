/** Canonical keys and keyword → key mapping. */

export const CANONICAL_KEYS = {
  PL_LIMIT: "insurance.public_liability.limit",
  PL_EXPIRY: "insurance.public_liability.expiry",
  EL_LIMIT: "insurance.employers_liability.limit",
  EL_EXPIRY: "insurance.employers_liability.expiry",
  EMPLOYEES: "company.employee_count",
  TURNOVER: "company.turnover",
  LEGAL_NAME: "company.legal_name",
  ISO9001_STATUS: "certification.iso_9001.status",
  ISO9001_EXPIRY: "certification.iso_9001.expiry",
  LIVING_WAGE: "policy.living_wage",
  // UK Construction prequalification canonical keys
  CSCS_STATUS: "certification.cscs.status",
  CSCS_EXPIRY: "certification.cscs.expiry",
  CPCS_STATUS: "certification.cpcs.status",
  CPCS_EXPIRY: "certification.cpcs.expiry",
  SMAS_STATUS: "certification.smas.status",
  SMAS_EXPIRY: "certification.smas.expiry",
  PROFESSIONAL_INDEMNITY_LIMIT: "insurance.professional_indemnity.limit",
  PROFESSIONAL_INDEMNITY_EXPIRY: "insurance.professional_indemnity.expiry",
  MOTOR_INSURANCE_LIMIT: "insurance.motor.limit",
  MOTOR_INSURANCE_EXPIRY: "insurance.motor.expiry",
  CYBER_ESSENTIALS_STATUS: "certification.cyber_essentials.status",
  CYBER_ESSENTIALS_EXPIRY: "certification.cyber_essentials.expiry",
  ISO_27001_STATUS: "certification.iso_27001.status",
  ISO_27001_EXPIRY: "certification.iso_27001.expiry",
  COMPANY_NUMBER: "company.company_number",
  BUSINESS_CONTINUITY_PLAN: "policy.business_continuity_plan",
} as const;

/** Keys that answer a headcount/turnover question — never a boolean policy. */
export const NUMERIC_STAT_KEYS = new Set<string>([CANONICAL_KEYS.EMPLOYEES, CANONICAL_KEYS.TURNOVER]);
