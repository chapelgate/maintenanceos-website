#!/usr/bin/env node
/**
 * Test wrapper for rollback-rehearsal.mjs.
 * Runs the rehearsal, requires exit 0, requires the pre-upgrade, upgraded, and
 * restored assertions, rejects output containing database URLs or secrets.
 */
import { test } from "node:test";
import assert from "node:assert/strict";
import { spawnSync } from "node:child_process";
import { createServer } from "node:net";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { findFreePort } from "./rollback-rehearsal.mjs";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const script = join(root, "scripts/rollback-rehearsal.mjs");
const RESERVED_PORTS = new Set([55432, 55434, 8080]);

function listenLoopback(port) {
  const server = createServer();
  return new Promise((resolve, reject) => {
    server.once("error", reject);
    server.listen(port, "127.0.0.1", () => resolve(server));
  });
}

