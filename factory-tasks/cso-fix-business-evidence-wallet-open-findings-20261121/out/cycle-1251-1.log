/**
 * Rollback rehearsal: proves a pre-upgrade physical backup can restore the
 * previous checkout after migrations 0011–0027 are applied.
 *
 * Runs entirely on synthetic local PostgreSQL. No hosted droplet, production
 * checkout, live database, Neon, or customer data.
 *
 * Port selection is fail-closed: it probes bind/listen state on 127.0.0.1
 * starting at 55435 and refuses any port already occupied by another listener.
 * The chosen port is never 55432, 55434, or 8080.
 */
import { createServer } from "node:net";
import { execFileSync } from "node:child_process";
import { mkdtempSync, realpathSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, dirname } from "node:path";
