const FIRST_PORT = 55435;
const LAST_PORT = 65000;

function execGit(args, cwd) {
  return execFileSync("git", args, { cwd, encoding: "utf8", timeout: 60_000 }).trim();
}

async function isAncestor(ancestor, commit) {
  try {
    execFileSync("git", ["merge-base", "--is-ancestor", ancestor, commit], { encoding: "utf8" });
    return true;
  } catch {
    return false;
  }
}

/**
 * Fail-closed port probe: try to open a real listener on each candidate port.
 * A port already occupied throws ECONNREFUSED/bind failure and is refused.
 */
function portIsOccupied(port) {
  return new Promise((resolve) => {
