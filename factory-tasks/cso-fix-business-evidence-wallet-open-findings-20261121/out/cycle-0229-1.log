-export const DEFAULT_RETENTION_CONFIG: RetentionConfig = {
-  documentRetentionDays: 0,
-  factRetentionDays: 0,
-  questionnaireRetentionDays: 0,
-  packRetentionDays: 0,
-  exportRetentionDays: 0,
-  auditRetentionDays: 2555,
-  deletionAuditRetentionDays: 2555,
-  purgeEnabled: false,
-  purgeSchedule: "0 2 * * *",
-};
-
-export function validateRetentionConfig(config: Partial<RetentionConfig>): {
-  ok: boolean;
-  error?: string;
-  value?: RetentionConfig;
-} {
-  const fields = [
-    { key: "documentRetentionDays", label: "Document retention" },
-    { key: "factRetentionDays", label: "Fact retention" },
-    { key: "questionnaireRetentionDays", label: "Questionnaire retention" },
-    { key: "packRetentionDays", label: "Pack retention" },
-    { key: "exportRetentionDays", label: "Export retention" },
-    { key: "auditRetentionDays", label: "Audit retention" },
-    { key: "deletionAuditRetentionDays", label: "Deletion audit retention" },
-  ] as const;
-
-  for (const f of fields) {
-    const val = config[f.key];
-    if (val !== undefined) {
-      if (!Number.isInteger(val) || val < 0) {
-        return { ok: false, error: `${f.label} must be a non-negative integer` };
-      }
-      if (val > 36500) {
-        return { ok: false, error: `${f.label} cannot exceed 36500 days (100 years)` };
-      }
-    }
-  }
-
-  if (config.purgeSchedule !== undefined) {
-    if (typeof config.purgeSchedule !== "string" || !config.purgeSchedule.trim()) {
-      return { ok: false, error: "Purge schedule must be a non-empty string" };
-    }
-    const cronParts = config.purgeSchedule.trim().split(/\s+/);
-    if (cronParts.length !== 5) {
-      return { ok: false, error: "Purge schedule must be a 5-field cron expression" };
-    }
-  }
-
-  return {
-    ok: true,
-    value: {
-      documentRetentionDays: config.documentRetentionDays ?? DEFAULT_RETENTION_CONFIG.documentRetentionDays,
-      factRetentionDays: config.factRetentionDays ?? DEFAULT_RETENTION_CONFIG.factRetentionDays,
-      questionnaireRetentionDays: config.questionnaireRetentionDays ?? DEFAULT_RETENTION_CONFIG.questionnaireRetentionDays,
-      packRetentionDays: config.packRetentionDays ?? DEFAULT_RETENTION_CONFIG.packRetentionDays,
-      exportRetentionDays: config.exportRetentionDays ?? DEFAULT_RETENTION_CONFIG.exportRetentionDays,
-      auditRetentionDays: config.auditRetentionDays ?? DEFAULT_RETENTION_CONFIG.auditRetentionDays,
-      deletionAuditRetentionDays: config.deletionAuditRetentionDays ?? DEFAULT_RETENTION_CONFIG.deletionAuditRetentionDays,
-      purgeEnabled: config.purgeEnabled ?? DEFAULT_RETENTION_CONFIG.purgeEnabled,
-      purgeSchedule: config.purgeSchedule ?? DEFAULT_RETENTION_CONFIG.purgeSchedule,
-    },
-  };
-}
-
-export function mapRetentionConfigRow(row: RetentionConfigRow): RetentionConfig {
-  return {
-    documentRetentionDays: row.document_retention_days,
-    factRetentionDays: row.fact_retention_days,
-    questionnaireRetentionDays: row.questionnaire_retention_days,
-    packRetentionDays: row.pack_retention_days,
-    exportRetentionDays: row.export_retention_days,
-    auditRetentionDays: row.audit_retention_days,
-    deletionAuditRetentionDays: row.deletion_audit_retention_days,
-    purgeEnabled: row.purge_enabled,
-    purgeSchedule: row.purge_schedule,
-  };
-}
-
-export type RetentionCheckResult = {
-  expired: boolean;
-  daysUntilExpiry: number | null;
-  retentionDays: number;
-};
-
-export function checkRetention(
-  createdAt: string | Date,
-  retentionDays: number,
-  now: Date = new Date(),
-): RetentionCheckResult {
-  if (retentionDays <= 0) {
-    return { expired: false, daysUntilExpiry: null, retentionDays: 0 };
-  }
-  const created = new Date(createdAt);
-  const expiry = new Date(created.getTime() + retentionDays * 24 * 60 * 60 * 1000);
-  const expired = now >= expiry;
-  const daysUntilExpiry = Math.ceil((expiry.getTime() - now.getTime()) / (24 * 60 * 60 * 1000));
-  return { expired, daysUntilExpiry: expired ? 0 : daysUntilExpiry, retentionDays };
-}
