import assert from "node:assert/strict";
import { existsSync, readFileSync } from "node:fs";
import { test } from "node:test";

const PATH = "docs/modules/housing-compliance-vault/RETENTION_HOLD.md";

test("retention hold names absent purge paths", () => {
  assert.equal(existsSync(PATH), true);
  const body = readFileSync(PATH, "utf8");
  assert.equal(body.startsWith("# Housing Compliance Vault"), true);
  assert.match(body, /Named module of Business Evidence Wallet/);
  assert.match(body, /no `src\/domain\/retention\.ts`/);
  assert.match(body, /no `scripts\/purge-expired\.mjs`/);
  assert.match(body, /NEEDS-ANDY/);
  assert.match(body, /#134/);
  assert.equal(existsSync("src/domain/housing"), false);
  assert.equal(existsSync("src/domain/retention.ts"), false);
  assert.equal(existsSync("scripts/purge-expired.mjs"), false);
  const backlog = readFileSync("docs/FACTORY_BACKLOG.md", "utf8");
  assert.match(backlog, /NEEDS-ANDY/);
  assert.match(backlog, /0043/);
});

test("retention hold forbids purge and erasure claims", () => {
  const body = readFileSync(PATH, "utf8");
  assert.match(body, /No automated retention-purge claim/);
  assert.match(body, /No erasure-complete claim/);
  assert.match(body, /No legal-hold engine claim/);
  assert.equal(/retention purge is live/i.test(body), false);
  assert.equal(/erasure is complete/i.test(body), false);
  assert.equal(/legal-hold engine is live/i.test(body), false);
});
