#!/usr/bin/env node
/**
 * Scan tracked files for accidental credentials. Prints paths and rule names,
 * never the matching secret text.
 */
import { execFileSync } from "node:child_process";
import { readFileSync } from "node:fs";

const RULES = [
  { id: "postgres-url-password", re: /postgres(?:ql)?:\/\/[^:\s/'"]+:[^@\s/'"]+@/i },
  { id: "better-auth-secret-assign", re: /BETTER_AUTH_SECRET\s*=\s*['"]?[A-Za-z0-9+/=_-]{16,}/ },
  { id: "private-key", re: /-----BEGIN (?:RSA |OPENSSH |EC )?PRIVATE KEY-----/ },
  { id: "xai-or-openai-key", re: /\b(?:sk-|xai-)[A-Za-z0-9]{20,}/ },
];

const SKIP = new Set(["package-lock.json"]);

function isPlaceholder(line, relPath = "") {
  if (
    /USER:PASSWORD|PASSWORD@|:\*\*\*@|changeme|placeholder|example\.com|\.example\b/i.test(line) ||
    /postgres:\/\/ew:\*\*\*@/.test(line) ||
    /127\.0\.0\.1|localhost|::1/.test(line) ||
    /encodeURIComponent|passwordFile|process\.env|\$\{/.test(line)
  ) {
    return true;
  }
  // Test files may embed dummy URLs to prove the scanner/preflight. A
  // non-dummy password in a test file is still a hit.
  if (/\.(test|spec)\.(mjs|js|ts|tsx)$/.test(relPath) && /postgres(?:ql)?:\/\//i.test(line)) {
    if (/:(?:x|xx|test|secret|password|supersecret|hunter2|changeme)@/i.test(line)) return true;
  }
  return false;
}

export function scanText(text, relPath) {
  const hits = [];
  const lines = text.split(/\n/);
  for (let i = 0; i < lines.length; i += 1) {
    const line = lines[i] ?? "";
    if (isPlaceholder(line, relPath)) continue;
    for (const rule of RULES) {
      if (rule.re.test(line)) hits.push({ path: relPath, line: i + 1, rule: rule.id });
    }
  }
  return hits;
}

export function scanGitTree(cwd = process.cwd()) {
  const files = execFileSync("git", ["ls-files"], { cwd, encoding: "utf8" })
    .split("\n")
    .map((s) => s.trim())
    .filter(Boolean)
    .filter((p) => !SKIP.has(p) && !p.startsWith("screenshots/") && !p.endsWith(".png"));
  const hits = [];
  for (const rel of files) {
    let text = "";
    try {
      text = readFileSync(rel, "utf8");
    } catch {
      continue;
    }
    hits.push(...scanText(text, rel));
  }
  return { files: files.length, hits };
}

function main() {
  const result = scanGitTree();
  console.log(JSON.stringify({ files: result.files, hitCount: result.hits.length, hits: result.hits }, null, 2));
  if (result.hits.length) process.exitCode = 1;
}

const invokedDirectly = process.argv[1]?.endsWith("secret-scan.mjs");
if (invokedDirectly) {
  main();
}
