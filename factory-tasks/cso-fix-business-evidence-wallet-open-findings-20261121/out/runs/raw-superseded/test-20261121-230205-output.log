  actual: |-
    import { Link, Outlet, useParams } from "@tanstack/react-router";
    import { useQuery } from "@tanstack/react-query";
    import { Menu } from "lucide-react";
    import { useEffect, useRef, useState } from "react";
    import { UserButton } from "@/lib/auth/gates";
    import { useMcpSetupUi } from "@/lib/mcp-setup-ui-client";
    import { cn } from "@/lib/utils";
    import { can, type Role, type Permission } from "@/domain/roles";
    import { getOrgFn } from "@/server/fns";
    
    const LINKS = [
      { to: "/app/$orgId", label: "Overview", permission: "read" as Permission },
      { to: "/app/$orgId/evidence", label: "Evidence", permission: "viewEvidence" as Permission },
      { to: "/app/$orgId/facts", label: "Facts", permission: "viewFacts" as Permission },
      { to: "/app/$orgId/compliance", label: "Compliance", permission: "viewCompliance" as Permission },
      { to: "/app/$orgId/decisions", label: "Decisions", permission: "viewDecisions" as Permission },
      { to: "/app/$orgId/opportunities", label: "Opportunities", permission: "viewOpportunities" as Permission },
      { to: "/app/$orgId/entities", label: "Entities", permission: "viewEntities" as Permission },
      { to: "/app/$orgId/questionnaires", label: "Questionnaires", permission: "uploadQuestionnaires" as Permission },
      { to: "/app/$orgId/packs", label: "Packs", permission: "viewPacks" as Permission },
      { to: "/app/$orgId/exports", label: "Exports", permission: "viewExports" as Permission },
      { to: "/app/$orgId/team", label: "Team", permission: "viewTeam" as Permission },
      { to: "/app/$orgId/audit", label: "Audit", permission: "viewAudit" as Permission },
    ] as const;
    
    export function OrgShell() {
      const { orgId } = useParams({ from: "/app/$orgId" });
      const org = useQuery({ queryKey: ["org", orgId], queryFn: () => getOrgFn({ data: { orgId } }) });
      const mcpSetupUi = useMcpSetupUi();
      const [open, setOpen] = useState(false);
      const navDialogRef = useRef<HTMLDivElement | null>(null);
      const menuButtonRef = useRef<HTMLButtonElement | null>(null);
      useEffect(() => {
        if (!open) return;
        const root = navDialogRef.current;
        const focusable = root?.querySelector<HTMLElement>('a[href], button:not([disabled])');
        focusable?.focus();
        return () => {
          menuButtonRef.current?.focus();
        };
      }, [open]);
      const renderNav = (role: string) => (
        <nav className="flex flex-col gap-1" aria-label="Organisation">
          {LINKS.filter((l) => can(role as Role, l.permission)).map((l) => (
            <Link
              key={l.label}
              to={l.to}
              params={{ orgId }}
              className="rounded-[10px] px-3 py-2 text-sm text-ink-soft hover:bg-paper-2"
              activeProps={{ className: "bg-paper-2 text-ink font-medium" }}
              onClick={() => setOpen(false)}
            >
              {l.label}
            </Link>
          ))}
          {role === "owner" && mcpSetupUi === "on" ? (
            <Link
              to="/app/$orgId/control-mcp"
              params={{ orgId }}
              className="rounded-[10px] px-3 py-2 text-sm text-ink-soft hover:bg-paper-2"
              activeProps={{ className: "bg-paper-2 text-ink font-medium" }}
              onClick={() => setOpen(false)}
            >
              MCP
            </Link>
          ) : null}
          <Link to="/app" className="mt-4 px-3 text-xs uppercase tracking-wider text-muted">
            All organisations
          </Link>
        </nav>
      );
    
      const role = org.data?.role;
      return (
        <div className="min-h-screen bg-paper lg:grid lg:grid-cols-[240px_1fr]">
          <aside className="hidden border-r border-line p-5 lg:block" aria-label="Organisation sidebar">
            <p className="font-display text-lg leading-tight">
              {org.data?.name ?? (org.isPending ? "…" : "Organisation")}
            </p>
            {org.data?.role ? (
              <p className="mb-6 text-xs uppercase tracking-wider text-muted">{org.data.role}</p>
            ) : null}
            {role ? renderNav(role) : null}
          </aside>
          <div>
            <header className="flex items-center justify-between border-b border-line px-4 py-3 lg:px-8">
              <button
                type="button"
                className="inline-flex min-h-11 min-w-11 items-center justify-center rounded-[10px] lg:hidden"
                onClick={() => setOpen((v) => !v)}
                ref={menuButtonRef}
                aria-label="Toggle navigation"
                aria-expanded={open}
                aria-controls="org-mobile-nav"
              >
                <Menu className="size-5" aria-hidden="true" />
              </button>
              <span className={cn("font-display text-base lg:hidden")}>{org.data?.name}</span>
              <div className="ml-auto">
                <UserButton />
              </div>
            </header>
            {org.isPending ? (
              <p role="status" className="px-4 pt-4 text-sm text-muted lg:px-8">
                Loading organisation…
              </p>
            ) : null}
            {org.error ? (
              <p role="alert" className="px-4 pt-4 text-sm text-red-ink lg:px-8">
                Organisation: {org.error.message}
              </p>
            ) : null}
            {open ? (
              <div
                id="org-mobile-nav"
