  actual: |-
    import { useQuery } from "@tanstack/react-query";
    import { createFileRoute, Link } from "@tanstack/react-router";
    import { getQuestionnaireFn } from "@/server/fns";
    
    export const Route = createFileRoute("/app/$orgId/questionnaires/$qid")({ component: QDetail });
    
    function QDetail() {
      const { orgId, qid } = Route.useParams();
      const q = useQuery({
        queryKey: ["qn", orgId, qid],
        queryFn: () => getQuestionnaireFn({ data: { orgId, questionnaireId: qid } }),
      });
      if (q.isPending) return <p role="status" aria-busy="true" className="text-muted">Loading…</p>;
      if (q.error) return <p role="alert" className="text-red-ink">{q.error.message}</p>;
      if (!q.data) return <p role="alert" className="text-red-ink">Questionnaire not found.</p>;
      return (
        <div className="space-y-4">
          <Link to="/app/$orgId/questionnaires" params={{ orgId }} className="text-sm text-muted underline">
            Questionnaires
          </Link>
          <h1 className="font-display text-3xl">{q.data.questionnaire.title}</h1>
          {q.data.questionnaire.uncertain_json && q.data.questionnaire.uncertain_json !== "[]" ? (
            <p role="status" className="rounded-[16px] border border-amber-ink/40 p-3 text-sm">
              Some lines were flagged as uncertain and were not turned into questions.
            </p>
          ) : null}
          {q.data.questions.length === 0 ? (
            <p role="status" className="text-sm text-muted">
              No questions were stored for this questionnaire.
            </p>
          ) : (
            <ol className="space-y-3">
              {q.data.questions.map((row, i) => (
                <li key={String(row.id)} className="rounded-[16px] border border-line p-4">
                  <p className="text-xs uppercase tracking-wider text-muted">
                    {String(row.question_identifier ?? i + 1)} · {String(row.section ?? "")}
                  </p>
                  <p className="mt-1">{String(row.question_text)}</p>
                </li>
              ))}
            </ol>
          )}
        </div>
      );
    }
    
