/** Browser headers for a privately operated wallet. */
export const WALLET_SECURITY_HEADERS: Record<string, string> = {
  "X-Content-Type-Options": "nosniff",
  "Referrer-Policy": "strict-origin-when-cross-origin",
  "X-Frame-Options": "DENY",
  "Cross-Origin-Opener-Policy": "same-origin",
  "Cross-Origin-Resource-Policy": "same-origin",
  "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
  "X-Robots-Tag": "noindex, nofollow",
  "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
};

const CSP_BASE = "default-src 'self' https://grok.com https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://grok.com; img-src 'self' data: https://grok.com; frame-ancestors 'none'; base-uri 'self';";

export function buildCsp(nonce?: string): string {
  const scriptSrc = nonce
    ? `script-src 'self' 'nonce-${nonce}' https://grok.com https://fonts.googleapis.com;`
    : "script-src 'self' 'unsafe-inline' https://grok.com https://fonts.googleapis.com;";
  const styleSrc = nonce
    ? `style-src 'self' 'nonce-${nonce}' https://fonts.googleapis.com;`
    : "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;";
  return `${CSP_BASE} ${scriptSrc} ${styleSrc}`;
}

export function mergeWalletSecurityHeaders(
  headers: HeadersInit | undefined = undefined,
  nonce?: string,
): Headers {
  const next = new Headers(headers);
  for (const [key, value] of Object.entries(WALLET_SECURITY_HEADERS)) {
    next.set(key, value);
  }
  next.set("Content-Security-Policy", buildCsp(nonce));
  return next;
}
