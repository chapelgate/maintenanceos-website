import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import { describe, it } from "node:test";

const {
  WALLET_SECURITY_HEADERS,
  mergeWalletSecurityHeaders,
} = await import("../src/server/security-headers.ts");

function ppTokens(pp) {
  return pp.split(",").map((p) => p.trim().split("=")[0]).filter(Boolean);
}

describe("security headers lock", () => {
  it("exports the private-wallet browser headers", () => {
    assert.equal(WALLET_SECURITY_HEADERS["X-Content-Type-Options"], "nosniff");
    assert.equal(WALLET_SECURITY_HEADERS["Referrer-Policy"], "no-referrer");
    assert.equal(WALLET_SECURITY_HEADERS["X-Robots-Tag"], "noindex, nofollow");
    assert.equal(WALLET_SECURITY_HEADERS["Cross-Origin-Opener-Policy"], "same-origin");
    assert.equal(WALLET_SECURITY_HEADERS["Cross-Origin-Resource-Policy"], "same-origin");
    assert.equal(
      WALLET_SECURITY_HEADERS["Strict-Transport-Security"],
      "max-age=31536000; includeSubDomains",
    );
    const tokens = ppTokens(WALLET_SECURITY_HEADERS["Permissions-Policy"]);
    for (const required of [
      "camera",
      "microphone",
      "geolocation",
      "payment",
      "attribution-reporting",
      "wake-lock",
      "writer",
    ]) {
      assert.equal(tokens.filter((t) => t === required).length, 1, required);
    }
    assert.equal("X-Frame-Options" in WALLET_SECURITY_HEADERS, false);
  });

  it("mergeWalletSecurityHeaders sets headers without inventing X-Frame-Options", () => {
    const headers = mergeWalletSecurityHeaders({
      "content-type": "application/json; charset=utf-8",
      "cache-control": "no-store",
    });
    assert.equal(headers.get("X-Content-Type-Options"), "nosniff");
    assert.equal(headers.get("Referrer-Policy"), "no-referrer");
    assert.equal(headers.get("X-Robots-Tag"), "noindex, nofollow");
    assert.equal(headers.get("Cross-Origin-Opener-Policy"), "same-origin");
    assert.equal(headers.get("Cross-Origin-Resource-Policy"), "same-origin");
    assert.equal(
      headers.get("Strict-Transport-Security"),
      "max-age=31536000; includeSubDomains",
    );
    const tokens = ppTokens(headers.get("Permissions-Policy") || "");
    assert.ok(tokens.includes("camera"));
    assert.ok(tokens.includes("writer"));
    assert.equal(headers.get("X-Frame-Options"), null);
    assert.equal(headers.get("content-type"), "application/json; charset=utf-8");
    assert.equal(headers.get("cache-control"), "no-store");
  });

  it("health.ts applies mergeWalletSecurityHeaders in jsonResponse", () => {
    const src = readFileSync("src/server/health.ts", "utf8");
    assert.ok(src.includes('from "@/server/security-headers"'));
    assert.ok(src.includes("mergeWalletSecurityHeaders"));
    assert.ok(src.includes("jsonResponse"));
    assert.ok(src.includes('"cache-control": "no-store"'));
  });

  it("SECURITY.md documents the header set including Permissions-Policy", () => {
    const sec = readFileSync("SECURITY.md", "utf8");
    assert.ok(sec.includes("X-Content-Type-Options: nosniff"));
    assert.ok(sec.includes("Referrer-Policy: no-referrer"));
    assert.ok(sec.includes("X-Robots-Tag: noindex, nofollow"));
    assert.ok(sec.includes("Permissions-Policy"));
    assert.ok(sec.includes("Strict-Transport-Security: max-age=31536000; includeSubDomains"));
    assert.ok(sec.includes("X-Frame-Options` is not set"));
  });
});
