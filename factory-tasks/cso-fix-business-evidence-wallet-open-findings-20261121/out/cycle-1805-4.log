/** Browser headers for a privately operated wallet. */
export const WALLET_SECURITY_HEADERS: Record<string, string> = {
  "X-Content-Type-Options": "nosniff",
  "Referrer-Policy": "no-referrer",
  "Cross-Origin-Opener-Policy": "same-origin",
  "Cross-Origin-Resource-Policy": "same-origin",
  "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
  "X-Robots-Tag": "noindex, nofollow",
  "Permissions-Policy": "accelerometer=(), all-screens-capture=(), ambient-light-sensor=(), autoplay=(), battery=(), bluetooth=(), browser-install=(), browsing-topics=(), capture=(), captured-surface-control=(), ch-device-memory=(), ch-downlink=(), ch-dpr=(), ch-ect=(), ch-lang=(), ch-prefers-color-scheme=(), ch-prefers-reduced-motion=(), ch-rtt=(), ch-save-data=(), ch-ua=(), ch-ua-arch=(), ch-ua-bitness=(), ch-ua-form-factors=(), ch-ua-full-version=(), ch-ua-full-version-list=(), ch-ua-high-entropy-values=(), ch-ua-mobile=(), ch-ua-model=(), ch-ua-platform=(), ch-ua-platform-version=(), ch-ua-wow64=(), ch-viewport-height=(), ch-viewport-width=(), ch-width=(), clipboard-read=(), clipboard-write=(), compute-pressure=(), conversion-measurement=(), camera=(), microphone=(), geolocation=(), payment=(), attribution-reporting=(), wake-lock=(), writer=(), cross-origin-isolated=(), deferred-fetch-minimal=(), deferred-fetch=(), digital-credentials-get=(), display-capture=(), document-domain=(), document-write=(), encrypted-media=(), execution-while-not-rendered=(), execution-while-out-of-viewport=(), focus-without-user-activation=(), fullscreen=(), gamepad=(), gyroscope=(), hid=(), html-attribute-or-property=(), identity-credentials-get=(), identity-credentials-create=(), idle-detection=(), interest-cohort=(), join-ad-interest-group=(), keyboard-map=(), language-detector=(), layout-animations=(), legacy-image-formats=(), local-fonts=(), magnetometer=(), manual-text=(), midi=(), navigation-override=(), on-device-speech-recognition=(), otp-credentials=(), oversized-images=(), picture-in-picture=(), private-aggregation=(), private-state-token-issuance=(), private-state-token-redemption=(), publickey-credentials-create=(), publickey-credentials-get=(), rewriter=(), run-ad-auction=(), screen-wake-lock=(), serial=(), shared-storage=(), shared-storage-select-url=(), smart-card=(), speaker-selection=(), storage-access=(), summarizer=(), sync-script=(), sync-xhr=(), top-level-storage-access=(), translator=(), trust-token-redemption=(), unload=(), unoptimized-images=(), usb=(), vertical-scroll=(), view-transition=(), web-share=(), webxr=(), window-management=(), xr=(), xr-spatial-tracking=()",
};

const CSP_BASE = "default-src 'self' https://grok.com https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://grok.com; img-src 'self' data: https://grok.com; frame-ancestors 'none'; base-uri 'self';";

export function buildCsp(nonce: string): string {
  const scriptSrc = `script-src 'self' 'nonce-${nonce}' https://grok.com https://fonts.googleapis.com;`;
  const styleSrc = `style-src 'self' 'nonce-${nonce}' https://fonts.googleapis.com;`;
  return `${CSP_BASE} ${scriptSrc} ${styleSrc}`;
}

export function mergeWalletSecurityHeaders(
  headers: HeadersInit | undefined = undefined,
  nonce: string,
): Headers {
  const next = new Headers(headers);
  for (const [key, value] of Object.entries(WALLET_SECURITY_HEADERS)) {
    next.set(key, value);
  }
  next.set("Content-Security-Policy", buildCsp(nonce));
  return next;
}
