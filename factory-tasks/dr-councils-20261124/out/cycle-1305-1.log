    echo "{\"cycle\":0,\"state\":\"BLOCKED: preflight - router guard plan violation\",\"updated\":\"$(date -Iseconds)\"}" > "$T/status.json"; exit 2
  fi
}

# v6.x FAILURE-LOG rule: prohibit docker stop on production OmniRoute port 20128
router_guard_production_check(){
  local plan="$T/BRIEF.md"
  [ -s "$T/STEER.md" ] && plan="$plan $T/STEER.md"
  if grep -E -i 'docker\s+(stop|kill|rm)\s+omniroute\b' "$plan" 2>/dev/null; then
    # Check if it's the production instance (port 20128)
    if grep -E -i '20128|production' "$plan" 2>/dev/null; then
      echo "PREFLIGHT FAIL: plan references docker stop/kill/rm on production OmniRoute (port 20128)" >&2
      mkdir -p "$T/out"; echo "BLOCKED: preflight - OmniRoute production protection" > "$T/out/PREFLIGHT-FAIL"
      echo "{\"cycle\":0,\"state\":\"BLOCKED: preflight - OmniRoute production protection\",\"updated\":\"$(date -Iseconds)\"}" > "$T/status.json"; exit 2
    fi
  fi
}
router_guard_production_check

router_guard_plan_check
# eggbot 24 Nov security-resilience-r1: injection scan hook (priority-lanes.conf inject_scan_*). External files attached via -f are scanned first; a hit is quarantined and never fed to the build.
SCAN=/home/andy/chapelgate/dell-services/inject-scan/scan.sh
safe_attach(){  # safe_attach <label> <file>... -> appends -f entries to F for clean files only
  local label=$1; shift
  local f
  for f in "$@"; do
    [ -s "$f" ] || continue
    if timeout 30 bash "$SCAN" "$f" "$label/$(basename $f)" 2>/dev/null; then
      F+=(-f "$f")
    else
      echo "$(date -Iseconds) INJECT SCAN: $f quarantined (label=$label) - excluded from prompt" >> "$T/history.log" 2>/dev/null || true
    fi
  done
}
