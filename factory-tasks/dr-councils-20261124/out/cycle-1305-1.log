#!/bin/bash
# mac-review.sh <prompt-file> <out-file>  (eggbot 23 Nov 2026, public chief 19:04)
# Second council family while qwen4-max-free is down: Mac LM Studio gpt-oss-120b via Dell 127.0.0.1:11234.
# Max 1 concurrent (MAC-AGENT-TRAINER-DIRECT 24 Nov 13:08, shared LM Studio with OpenClaw), 600s timeout. Exit 0 = review written; 3 = Mac timed out/failed -> caller retries on estate-coding and names it.
set -u; PF=$1; OUT=$2; L=/home/andy/chapelgate/dell-services/model-pin/mac-review; mkdir -p "$(dirname "$OUT")"
for i in 1; do exec 9>$L/slot$i.lock; if flock -n 9; then SLOT=$i; break; fi; done
if [ -z "${SLOT:-}" ]; then exec 9>$L/slot1.lock; flock -w 600 9 || { echo "$(date -Is) no slot" >> $L/mac-review.log; exit 3; }; SLOT=1; fi
python3 - "$PF" > $L/req.$$.json <<'PY'
import json,sys
print(json.dumps({"model":"gpt-oss-120b","messages":[{"role":"user","content":open(sys.argv[1]).read()}],"max_tokens":6000,"temperature":0.2}))
PY
# eggbot 24 Nov 12:50: retry empty replies (rc=52/56, ~50% of calls today while LM Studio is shared with OpenClaw) up to 3 tries
s=$(date +%s); for try in 1 2 3; do timeout 600 curl -s -m 600 http://127.0.0.1:11234/v1/chat/completions -H 'Content-Type: application/json' -d @$L/req.$$.json > $L/resp.$$.json; rc=$?; case $rc in 52|56|7) echo "$(date -Is) slot$SLOT retry$try rc=$rc $PF" >> $L/mac-review.log; [ $try -lt 3 ] && sleep $((30*(1<<(try-1))));; *) break;; esac; done; rm -f $L/req.$$.json
txt=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['choices'][0]['message']['content'])" $L/resp.$$.json 2>/dev/null)
if [ $rc -ne 0 ] || [ -z "$txt" ]; then echo "$(date -Is) slot$SLOT FAIL no-answer rc=$rc $(( $(date +%s)-s ))s $PF" >> $L/mac-review.log; mv $L/resp.$$.json "$OUT.mac-raw-failed" 2>/dev/null; exit 3; fi
{ echo "<!-- family: mac/gpt-oss-120b (LM Studio, Mac Studio) via 127.0.0.1:11234; $(date -Is); $(( $(date +%s)-s ))s -->"; echo "$txt"; } > "$OUT"; mv $L/resp.$$.json "$OUT.raw.json"
echo "$(date -Is) slot$SLOT OK $(( $(date +%s)-s ))s $OUT" >> $L/mac-review.log; exit 0
