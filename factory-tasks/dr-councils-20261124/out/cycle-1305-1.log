#!/bin/bash
# launch-council.sh <task-name> "<Product name>" <github owner/repo> <dell clone path> <full sha> [cycles]  (eggbot 23 Nov 2026)
# enforces gate (a): refuses to launch unless the sha is in the Dell clone; clones it into $T/repo at that sha.
set -eu
N=$1; P=$2; GH=$3; SRC=$4; SHA=$5; CY=${6:-30}
C=/home/andy/chapelgate; T=$C/factory-tasks/$N; R=$C/jobs-work-dell/tasks/dell-fix-failing-builds-20261111/job-run-v6.sh
[[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "need full 40-char sha"; exit 2; }
git -C "$SRC" cat-file -e "$SHA^{commit}" 2>/dev/null || git -C "$SRC" fetch --all -q 2>/dev/null || true
git -C "$SRC" cat-file -e "$SHA^{commit}" 2>/dev/null || { echo "REFUSED: $SHA not in $SRC"; exit 3; }
mkdir -p $T/out/raw; [ -d $T/repo ] || git clone -q --no-checkout "$SRC" $T/repo
git -C $T/repo fetch -q origin "$SHA" 2>/dev/null || true; git -C $T/repo checkout -q --detach "$SHA"
[ "$(git -C $T/repo rev-parse HEAD)" = "$SHA" ] || { echo "REFUSED: checkout mismatch"; exit 4; }
echo "$SHA" > $T/out/raw/TARGET-SHA
BASE=$(git -C $T/repo merge-base "$SHA" origin/main 2>/dev/null || git -C $T/repo merge-base "$SHA" origin/master 2>/dev/null || echo "")
cat > $T/BRIEF.md <<B
# council go/no-go: $P @ $SHA (GitHub $GH)
./repo is checked out at $SHA by the launcher. First check: git -C repo rev-parse HEAD == $SHA, else NO-GO "sha not in repo".
Base for the diff: ${BASE:-origin default branch merge-base}. Never push, never merge, never touch production, the golden voice line or secrets.
1. git -C repo diff ${BASE:-HEAD~1}..$SHA > out/branch.diff
2. Run the product's full test suite, typecheck and lint with rt (rt <name> -- <cmd>): raw stdout + exit code land in out/raw. Pass counts come only from there.
3. Reviews (both given out/branch.diff AND the raw logs): estate-coding = your own review in out/review-estate-coding.md with file:line; mac gpt-oss-120b = bash $C/dell-services/model-pin/mac-review/mac-review.sh out/review-prompt.txt out/review-mac-gpt-oss-120b.md. Empty review = NO-GO. A review claiming a pass the raw contradicts = FAIL (RUNNER-RULES rule 6).
4. out/VERDICT.md line 1: "COUNCIL GO $P $SHA" or "COUNCIL NO-GO $P $SHA", then file:line findings and the raw log paths.
5. On GO with raw exit 0 and both reviews non-empty: out/MISSION_COMPLETE line 1 "<N> passed (<out/raw log>)", line 2 the full SHA. dr eggbot pushes to GitHub main through the Mac and records it in readiness/MERGED-ON-GITHUB.tsv.
6. On NO-GO: write the gaps to out/GAPS.md and MISSION_COMPLETE with line 1 "NO-GO" so the product lane can fix them.
See readiness/brief-template.md section "Council evidence gate".
B
echo estate-coding > $T/MODEL
systemctl --user reset-failed job-$N 2>/dev/null || true
systemd-run --user --unit=job-$N --working-directory=$T /usr/bin/bash $R $T $CY >/dev/null 2>&1
echo "launched job-$N"
