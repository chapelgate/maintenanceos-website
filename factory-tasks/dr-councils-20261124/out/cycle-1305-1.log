#!/bin/bash
export JOBRUN_ZEN=1  # v6.11 eggbot 23 Nov: this runner passes opencode/* models as-is
# v6.5 front-port (eggbot 16 Nov 2026): updated to use front port 20140 for router health gate
# and opencode model "omniroute/estate-coding" (which now points to 20140 via opencode.json)
# The front proxy handles failover: 20128 -> 20131 -> 11234
export OPENCODE_CONFIG="${OPENCODE_CONFIG:-/home/andy/chapelgate/dell-services/opencode-guard/opencode-guard.json}"  # eggbot 20 Nov: deny kills on live router ports (17:41 SIGKILL)
# eggbot 23 Nov D392: stall watchdog. kills a cycle whose log has not grown for STALL_S seconds (default 600), exit 125, logs STALL KILL
run_watched() {
  local log="$1"; shift
  # eggbot 23 Nov 20:40 public chief: cap estate-coding concurrent cycles (cap in model-pin/estate-coding.cap, default 12); over cap queues, never falls back to Zen
  if [[ "$MM" == *estate-coding ]]; then
    local cap q=0 n
    while :; do
      cap=$(cat /home/andy/chapelgate/dell-services/model-pin/estate-coding.cap 2>/dev/null || echo 12)
      n=$(for d in /proc/[0-9]*; do [ "$(cat $d/comm 2>/dev/null)" = opencode ] && tr '\0' ' ' < $d/cmdline 2>/dev/null | grep -q -- '-m omniroute/estate-coding' && echo x; done | wc -l)
      # eggbot 23 Nov 23:25 (public chief slot order): tier 1 councils+rootcause, 2 HCV+CSO-fix/fix-findings, 3 CM/CA/LCM, 4 other products, 5 GTM/financials/video.
      # each waiter touches model-pin/ec-wait/<tier>-<task>; a job proceeds only if a slot is free and no fresh (<90s) marker of a better tier exists.
      local EW=/home/andy/chapelgate/dell-services/model-pin/ec-wait tb=$(basename $T) tier=4 x better=0
      # eggbot 24 Nov 01:05 (Andy voice): tiers come from the single source of truth model-pin/priority-lanes.conf (first glob match wins, default 4)
      local PL=/home/andy/chapelgate/dell-services/model-pin/priority-lanes.conf pt pg
      if [ -r $PL ]; then while IFS=$'\t' read -r pt pg; do case "$pt" in [1-5]) ;; *) continue;; esac; [[ "$tb" == $pg ]] && { tier=$pt; break; }; done < $PL; fi
      # eggbot 24 Nov 01:15 (Andy voice): councils are never a bottleneck. Council-class jobs (council_globs in priority-lanes.conf) skip the build queue
      # and may use council_reserved_slots extra slots above the build cap; builds can never take those slots.
      local cg cres=4 isc=0
      if [ -r $PL ]; then cg=$(sed -n 's/^council_globs=//p' $PL | tail -1 | cut -d'#' -f1 | tr -d ' '); cres=$(sed -n 's/^council_reserved_slots=//p' $PL | tail -1 | cut -d'#' -f1 | tr -d ' '); fi
      local -a cga=(); IFS=, read -ra cga <<< "$cg"; for x in "${cga[@]}"; do [[ "$tb" == $x ]] && { isc=1; break; }; done
      local cx; cx=$(sed -n 's/^council_exclude_globs=//p' $PL 2>/dev/null | tail -1 | cut -d'#' -f1 | tr -d ' '); IFS=, read -ra cga <<< "$cx"; for x in "${cga[@]}"; do [[ "$tb" == $x ]] && isc=0; done
      if [ $isc -eq 1 ] && [ "$n" -lt $((cap+${cres:-4})) ]; then rm -f $EW/*-$tb; [ $q -eq 1 ] && echo "$(date -Iseconds) EC QUEUE: council fast lane, slot taken" >> $T/history.log; break; fi
      touch $EW/$tier-$tb
      if [ "$n" -lt "$cap" ]; then
        # higher tiers go first, but never leave a slot idle: proceed if free slots exceed fresh higher-tier waiters
        better=0; for x in $(find $EW -type f -newermt '-90 seconds' -printf '%f\n' 2>/dev/null); do [ "${x%%-*}" -lt "$tier" ] 2>/dev/null && better=$((better+1)); done
        [ $((cap-n)) -gt $better ] && { rm -f $EW/$tier-$tb; break; }
      fi
      [ $q -eq 0 ] && echo "$(date -Iseconds) EC QUEUE: estate-coding at $n/$cap, waiting for a slot (tier=$tier)" >> $T/history.log; q=1; [ $isc -eq 1 ] && sleep 3 || sleep $((tier*6+4))
    done
  fi
  "$@" >> "$log" 2>&1 &
  local pid=$! last=-1 still=0 sz
  echo $pid > $T/out/.cycle.pid  # job's own PID file (replaces pgrep)
  while kill -0 $pid 2>/dev/null; do
    sleep 30
    sz=$(stat -c %s "$log" 2>/dev/null || echo 0)
    if [ "$sz" = "$last" ]; then still=$((still+30)); else still=0; last=$sz; fi
    if [ $still -ge ${STALL_S:-900} ]; then
      echo "$(date -Iseconds) STALL KILL: no log output for ${still}s, model $MM, pid $pid" >> $T/history.log
      pkill -TERM -P $pid 2>/dev/null; kill -TERM $pid 2>/dev/null; sleep 10; pkill -KILL -P $pid 2>/dev/null; kill -KILL $pid 2>/dev/null
      wait $pid 2>/dev/null; return 125
    fi
  done
  wait $pid
}
