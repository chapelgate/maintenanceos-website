# LOCAL E2E ONLY — copy to .env.local for `npm run dev` / `npm run build`.
# Do not paste these values into DigitalOcean App Platform static hosting.
# Companion flags below are process-only (not inlined by Next).
# Names verified against src/config/site.ts and package READMEs.
# Runbook: docs/FONIO_LOCAL_E2E.md

# --- Next.js (inlined at dev/build; static export cannot use relative /api routes) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=local
NEXT_PUBLIC_PUBLIC_LAUNCH=false

# Empty = client-side form stub (no email). Optional loopback stub:
#   NEXT_PUBLIC_FORM_ENDPOINT=http://127.0.0.1:8787/leads
NEXT_PUBLIC_FORM_ENDPOINT=

# /create scan (src/lib/onboarding-create.ts → POST { "url" })
NEXT_PUBLIC_ONBOARDING_SCAN_ENDPOINT=http://127.0.0.1:8788/v1/onboarding/scan

# /create calendar panel (src/lib/calendar-create.ts → {endpoint}/slots and /bookings)
NEXT_PUBLIC_CALENDAR_ADAPTERS_ENABLED=true
NEXT_PUBLIC_CALENDAR_ENDPOINT=http://127.0.0.1:8789/v1/calendar

# /create sandbox panel (src/lib/sandbox-test-call.ts → {endpoint}/sessions and …/test-call)
NEXT_PUBLIC_SANDBOX_TEST_CALL_ENABLED=true
NEXT_PUBLIC_SANDBOX_TEST_CALL_ENDPOINT=http://127.0.0.1:8790/v1/sandbox

# Optional /dashboard (src/lib/customer-dashboard.ts → {endpoint}/sessions and /bookings)
# Unset both (or set ENABLED=false) if you start the stack with --no-dashboard.
NEXT_PUBLIC_CUSTOMER_DASHBOARD_ENABLED=true
NEXT_PUBLIC_CUSTOMER_DASHBOARD_ENDPOINT=http://127.0.0.1:8791/v1/dashboard

# --- Companion processes (scripts/fonio-local-stack.sh / docker-compose.fonio-local.yml) ---
ONBOARDING_WEB_INGEST=true
ONBOARDING_SCAN_HOST=127.0.0.1
ONBOARDING_SCAN_PORT=8788

CALENDAR_ADAPTERS_ENABLED=true
CALENDAR_ADAPTER_PROVIDER=mock
CALENDAR_ADAPTERS_HOST=127.0.0.1
CALENDAR_ADAPTERS_PORT=8789
# Optional local Google OAuth (keep provider=mock for this stack). Never commit secrets.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8789/oauth/google/callback
# GOOGLE_CALENDAR_TOKEN_FILE=.data/google-calendar-tokens.json

SANDBOX_TEST_CALL_ENABLED=true
ONBOARDING_SANDBOX_CALL=true
SANDBOX_TEST_CALL_HOST=127.0.0.1
SANDBOX_TEST_CALL_PORT=8790

CUSTOMER_DASHBOARD_ENABLED=true
CUSTOMER_DASHBOARD_DEMO_DATA=true
CUSTOMER_DASHBOARD_HOST=127.0.0.1
CUSTOMER_DASHBOARD_PORT=8791

# Optional form stub (not started by default):
# FORM_STUB_HOST=127.0.0.1
# FORM_STUB_PORT=8787
