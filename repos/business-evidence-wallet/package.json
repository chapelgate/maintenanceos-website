{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port ${EW_HTTP_PORT:-8080}",
    "build": "node scripts/with-app-env.mjs vite build && npm run db:migrate && node scripts/copy-pglite-assets.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "typecheck": "tsc --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "node --experimental-strip-types --import ./scripts/ts-test-register.mjs --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test src/lib/app-data/app-data.test.ts src/lib/app-data/readiness-schedule.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/sign-in-gate.test.ts src/lib/auth/signup-policy.test.ts src/lib/format-wallet-timestamp.test.ts",
    "test:domain": "node --experimental-strip-types --import ./scripts/ts-test-register.mjs --test src/domain/*.test.ts src/domain/v2/*.test.ts src/domain/v2/agent-loop/*.test.ts",
    "test:integration": "node --experimental-strip-types --import ./scripts/ts-test-register.mjs --test tests/*.test.mjs",
    "test:control-mcp": "node --test tests/control-mcp.test.mjs",
    "test:app": "npm run test:domain && npm run test:integration",
    "test:mutation-isolation": "node scripts/mutation-isolation.mjs",
    "test:live-idor": "node scripts/live-http-idor.mjs",
    "test:gateway-cert": "node --experimental-strip-types --import ./scripts/ts-test-register.mjs scripts/gateway-phase-o-cert.mjs",
    "test:concurrency-pg": "node --experimental-strip-types --import ./scripts/ts-test-register.mjs --test tests/concurrency-pg.test.mjs",
    "test:persistence": "node --experimental-strip-types --import ./scripts/ts-test-register.mjs scripts/pg-restart-persistence.mjs",
    "test:http-persistence": "node scripts/http-restart-persistence.mjs",
    "test:backup": "node scripts/pg-backup-restore.mjs",
    "test:hosted-probe": "node scripts/hosted-probe.mjs",
    "test:hosted-preflight": "node scripts/staging-preflight.mjs",
    "test:hosted-acceptance": "node scripts/hosted-acceptance.mjs",
    "test:secret-scan": "node scripts/secret-scan.mjs",
    "pg:start": "node scripts/pg-local.mjs start",
    "pg:stop": "node scripts/pg-local.mjs stop",
    "pg:status": "node scripts/pg-local.mjs status",
    "test:platform": "npm test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@hookform/resolvers": "5.9.2",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/router-plugin": "1.168.48",
    "@xmldom/xmldom": "0.9.12",
    "better-auth": "1.7.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embedded-postgres": "18.7.0-beta.19",
    "jose": "6.2.9",
    "jszip": "3.10.2",
    "kysely": "0.28.19",
    "lucide-react": "0.510.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-resizable-panels": "4.17.0",
    "recharts": "2.15.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@types/jszip": "3.4.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "6.15.0",
    "eslint-plugin-prettier": "2.7.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "lightningcss": "1.33.0",
    "nitro": "3.0.260610-beta",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.14.0",
    "vite": "8.3.5"
  },
  "version": "0.0.0-private"
}
